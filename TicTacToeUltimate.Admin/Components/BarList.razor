@* Horizontal bars (stacked when a row has several parts): 2px gaps between parts, labels in ink, legend + table view. *@
@if (Rows.Count == 0)
{
    <p class="muted small">No data yet.</p>
}
else
{
    <div class="bars" role="list">
        @foreach (var r in Rows)
        {
            var total = r.Parts.Sum(p => p.Value);
            <div class="bar-row" role="listitem">
                <span title="@r.Label" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Label</span>
                <div class="bar-track" style="width:@Pct(total)%">
                    @foreach (var p in r.Parts.Where(p => p.Value > 0))
                    {
                        <span class="bar-seg" style="flex:@p.Value;background:var(@p.Color)" title="@($"{r.Label} · {p.Name}: {p.Value:N0}")"></span>
                    }
                </div>
                <span class="num" style="text-align:right;font-variant-numeric:tabular-nums">@total.ToString("N0", CultureInfo.InvariantCulture)</span>
            </div>
        }
    </div>
    @if (Rows.Any(r => r.Parts.Count > 1))
    {
        <div class="legend">@foreach (var (name, color) in Legend) { <span><i style="background:var(@color)"></i>@name</span> }</div>
    }
}

@code {
    public sealed record Part(string Name, long Value, string Color);
    public sealed record Row(string Label, IReadOnlyList<Part> Parts);

    [Parameter, EditorRequired] public IReadOnlyList<Row> Rows { get; set; } = [];

    private IReadOnlyList<(string Name, string Color)> Legend => Rows.SelectMany(r => r.Parts).Select(p => (p.Name, p.Color)).Distinct().ToList();
    private double Pct(long v) { var max = Rows.Max(r => r.Parts.Sum(p => p.Value)); return max == 0 ? 0 : Math.Max(1, v * 100.0 / max); }
}
