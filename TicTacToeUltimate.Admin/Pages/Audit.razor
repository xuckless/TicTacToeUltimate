@page "/audit"
@inject AdminApi Api

<PageTitle>Audit log · TTT Admin</PageTitle>
<div class="page-head"><div><h1>Audit log</h1><span class="muted small">Every admin action, newest first.</span></div></div>
<div class="card"><div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Admin</th><th>Action</th><th>Target</th><th>Detail</th></tr></thead>
    <tbody>@foreach (var a in _list) { <tr><td><Ago At="a.At" /></td><td>@a.AdminEmail</td><td>@a.Action</td><td class="mono">@a.Target</td><td class="mono small">@a.DetailJson</td></tr> }</tbody>
</table></div></div>

@code {
    private AuditDto[] _list = [];
    protected override async Task OnInitializedAsync() => _list = await Api.AuditAsync() ?? [];
}
