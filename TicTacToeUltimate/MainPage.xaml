<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shared="clr-namespace:TicTacToeUltimate.Shared;assembly=TicTacToeUltimate.Shared"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Class="TicTacToeUltimate.MainPage"
    ios:Page.UseSafeArea="False"
    SafeAreaEdges="None"
    BackgroundColor="#120a22">

    <Grid RowDefinitions="*,Auto">
        <BlazorWebView x:Name="BlazorWebView" HostPage="wwwroot/index.html" Grid.Row="0">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
        <!-- Native AdMob banner (iOS/Android), added from code-behind so Mac Catalyst and Debug-without-ads stay clean. -->
        <ContentView x:Name="BannerHost" Grid.Row="1" IsVisible="False" BackgroundColor="#120a22" />
    </Grid>
</ContentPage>
