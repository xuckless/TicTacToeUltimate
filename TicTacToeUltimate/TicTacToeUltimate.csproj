<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>

        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

        <!-- Lock restore for identical packages across machines -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!-- Diagnostics without breaking builds -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>

        <!-- Keep warnings non-fatal -->
        <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->

        <!-- Trim path noise in PDBs for reproducibility -->
        <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>

        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

        <!-- Note for MacCatalyst:
          The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
          When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
          The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
          either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>TicTacToeUltimate</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>true</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>Tic Tac Toe Ultimate</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.wedirectsoftwares.tictactoeultimate</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>2</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- Store builds. Android: signed AAB when TTT_ANDROID_KEYSTORE is set (see DEPLOYMENT_GUIDE.md). -->
    <PropertyGroup Condition="'$(Configuration)'=='Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidPackageFormat>aab</AndroidPackageFormat>
        <AndroidLinkTool>r8</AndroidLinkTool>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Release' And '$(TTT_ANDROID_KEYSTORE)'!=''">
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>$(TTT_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>$(TTT_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>env:TTT_ANDROID_STORE_PASS</AndroidSigningStorePass>
        <AndroidSigningKeyPass>env:TTT_ANDROID_STORE_PASS</AndroidSigningKeyPass>
    </PropertyGroup>
    <!-- iOS: device/App Store builds sign with these when set (Apple Developer account required). -->
    <PropertyGroup Condition="'$(Configuration)'=='Release' And '$(TTT_IOS_CODESIGN_KEY)'!=''">
        <CodesignKey>$(TTT_IOS_CODESIGN_KEY)</CodesignKey>
        <CodesignProvision>$(TTT_IOS_PROVISIONING_PROFILE)</CodesignProvision>
        <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
        <ArchiveOnBuild>true</ArchiveOnBuild>
    </PropertyGroup>
    <!-- Apple privacy manifest (required reason APIs + AdMob tracking). Missing manifest = ITMS-91053 at upload. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
    </ItemGroup>

    <!-- macOS store rule: both archs or x64 only -->
    <PropertyGroup Condition="'$(Configuration)'=='Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)'=='Release'">
        <Content Update="wwwroot\**\*">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#7442ef"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#120a22" BaseSize="160,160"/>

        <!-- Blazor static web assets -->
        <Content Update="wwwroot\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <!-- If you have MAUI (non-Blazor) CSS, include it explicitly -->
        <!-- <MauiCss Include="Resources\Styles\**\*.css" /> -->

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
        <Content Remove="Resources\Raw\appsettings.json"/>
        <EmbeddedResource Include="Resources\Raw\appsettings.json" LogicalName="appsettings.json"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" VersionOverride="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug"/>
        <PackageReference Include="Plugin.AdMob"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TicTacToeUltimate.Shared\TicTacToeUltimate.Shared.csproj"/>
    </ItemGroup>

    <!-- Google Mobile Ads (Swift) needs the Swift runtime libraries on iOS. -->
    <Target Name="LinkWithSwift" DependsOnTargets="_ParseBundlerArguments;_DetectSdkLocations" BeforeTargets="_LinkNativeExecutable"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <PropertyGroup>
            <_SwiftPlatform Condition="$(RuntimeIdentifier.StartsWith('iossimulator-'))">iphonesimulator</_SwiftPlatform>
            <_SwiftPlatform Condition="$(RuntimeIdentifier.StartsWith('ios-'))">iphoneos</_SwiftPlatform>
        </PropertyGroup>
        <ItemGroup>
            <_CustomLinkFlags Include="-L" />
            <_CustomLinkFlags Include="/usr/lib/swift" />
            <_CustomLinkFlags Include="-L" />
            <_CustomLinkFlags Include="$(_SdkDevPath)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(_SwiftPlatform)" />
            <_CustomLinkFlags Include="-Wl,-rpath" />
            <_CustomLinkFlags Include="-Wl,/usr/lib/swift" />
        </ItemGroup>
    </Target>

</Project>
