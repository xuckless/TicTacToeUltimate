@inherits LayoutComponentBase
@using TicTacToeUltimate.Shared.Services
@inject IServiceProvider Services
@inject AmbienceService Ambience
@implements IDisposable

<Wallpaper />
<div class="sd-edge @Ambience.Edge" aria-hidden="true"></div>
<div class="match-shell">
    @* Owner decision 2026-10-16: a banner is fine during play; interstitials never. *@
    <CascadingValue Name="AdsAllowed" Value="true" IsFixed="true">
        @Body
    </CascadingValue>
</div>

@code {
    private IAdCoordinator? Ads => Services.GetService(typeof(IAdCoordinator)) as IAdCoordinator;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Ads?.SetMatchRouteActive(true);
        Ambience.Set(AmbienceMode.Match);
        Ambience.Changed += OnAmbience;
    }

    private void OnAmbience() => InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose()
    {
        Ads?.SetMatchRouteActive(false);
        Ambience.Changed -= OnAmbience;
        Ambience.Set(AmbienceMode.Menu);
    }
}
