@inject ISessionStore Session
@inject IModerationStore Moderation
@inject NavigationManager Nav
@implements IDisposable

@if (IsOfflineRoute)
{
    @* Pass & Play works with no server and no session. *@
    @ChildContent
}
else if (Moderation.State.Ban is { } ban)
{
    @* Banned account or device: nothing else runs; the player can read why and appeal once. *@
    <div class="ban-screen"><div>
        <PenaltyNotice Penalty="ban">
            <a class="t-small" href="mailto:hello@alidirect.dev">Contact support</a>
        </PenaltyNotice>
    </div></div>
}
else if ((_error is not null || Session.State.Error == "offline") && Session.State is { Status: SessionStatus.Initializing or SessionStatus.SignedOut, Config: null })
{
    @* Config never loaded: the server is unreachable (or down). Offer Pass & Play instead of a sign-in page that cannot work. *@
    <div class="splash" style="flex-direction:column;gap:16px;text-align:center;padding:16px" data-testid="offline-splash">
        <Bert Mood="sleepy" Size="72" />
        <span>Can't reach the server</span>
        <span class="t-small t-muted">@(_error ?? "Check your connection, or play offline for now.")</span>
        <Button OnClick="Init">Retry</Button>
        <Button Variant="secondary" Href="local">Play offline · Pass &amp; Play</Button>
    </div>
}
else if (Session.State.Status == SessionStatus.Initializing && Session.State.WakingSeconds > 0)
{
    @* Server restarting or waking up: a friendly buffer instead of an error. *@
    <div class="splash wake" role="status" data-testid="waking">
        <span class="splash-logo"><BounceText Text="Tic Tac Toe" /> <BounceText Text="Ultimate" Class="ultimate" /></span>
        <BertLoader Text="Waking up the game server" Mood="sleepy" />
        <span class="t-small t-muted">This takes a few seconds after a restart. Hang tight!</span>
        <div class="wake-bar" aria-hidden="true"><span style="width:@(Math.Min(100, Session.State.WakingSeconds * 100 / 60))%"></span></div>
        <Button Variant="ghost" Small="true" Href="local">Play offline meanwhile · Pass &amp; Play</Button>
    </div>
}
else if (Session.State.Status == SessionStatus.Initializing || RedirectTarget() is not null)
{
    <div class="splash" role="status" style="flex-direction:column;gap:6px"><span class="splash-logo"><BounceText Text="Tic Tac Toe" /> <BounceText Text="Ultimate" Class="ultimate" /></span><BertLoader Text="Warming up" Mood="jumpy" /></div>
}
else
{
    @ChildContent
}

@code {
    private string? _error;

    /// <summary>Routed content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Moderation.Changed += OnChanged;
        Nav.LocationChanged += OnLocation;
        await Init();
    }

    private async Task Init()
    {
        _error = null;
        try { await Session.InitializeAsync(); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException or TimeoutException)
        {
            _error = ex.Message;
        }
        Redirect();
    }

    private void OnChanged() => _ = InvokeAsync(() => { Redirect(); StateHasChanged(); });
    private void OnLocation(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() => { Redirect(); StateHasChanged(); });

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    /// <summary>Offline pass-and-play routes never wait for (or redirect on) the session.</summary>
    private bool IsOfflineRoute => Path == "local" || Path.StartsWith("local/", StringComparison.Ordinal) || Path == "dev/ads";

    /// <summary>Where the current route must redirect to, or null.</summary>
    private string? RedirectTarget()
    {
        if (IsOfflineRoute) return null;
        var s = Session.State;
        var path = Path;
        if (s.Status == SessionStatus.SignedOut)
        {
            if (path == "signin" || path.StartsWith("c/", StringComparison.Ordinal)) return null;
            // The whole relative URL (path + query, e.g. play?tc=ArenaRanked) comes back after sign-in.
            var returnUrl = Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0]);
            return "signin?returnUrl=" + returnUrl;
        }
        if (s.Status == SessionStatus.SignedIn && s.Me is { Kind: AccountKind.Account, NeedsUsername: true } && path != "onboarding")
            return "onboarding";
        return null;
    }

    private void Redirect()
    {
        var target = RedirectTarget();
        if (target is not null) Nav.NavigateTo(target, replace: true);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Moderation.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocation;
    }
}
