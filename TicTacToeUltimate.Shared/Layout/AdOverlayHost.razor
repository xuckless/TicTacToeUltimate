@inject AdOverlayService Overlay
@implements IDisposable

@if (_request is not null)
{
    <div class="ad-overlay" role="dialog" aria-modal="true" aria-label="Advertisement">
        <div class="box">
            <IconButton Class="close" Label="@(_left > 0 ? "Close ad (no reward)" : "Close ad")" Icon="close" Round="true" OnClick="Close" />
            <span class="t-label t-muted">@(_request.Kind == "rewarded" ? "Rewarded ad" : "Ad")</span>
            <div class="t-title">Your ad here</div>
            <p class="t-muted t-small">Stub ad. Real ads come later.</p>
            @if (_request.Reward is RewardKind r)
            {
                <p class="t-small">Reward: @RewardText(r)</p>
            }
            <div class="t-num" style="font:var(--type-clock)" role="timer">@(_left > 0 ? $"{_left}s" : "Done")</div>
            @if (_left <= 0)
            {
                <Button Variant="primary" OnClick="Finish">@(_request.Reward is null ? "Continue" : "Claim reward")</Button>
            }
        </div>
    </div>
}

@code {
    private AdOverlayRequest? _request;
    private int _left;
    private CancellationTokenSource? _cts;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Overlay.Changed += OnChanged;
        Sync();
    }

    private void OnChanged() => _ = InvokeAsync(() => { Sync(); StateHasChanged(); });

    private void Sync()
    {
        var current = Overlay.Current;
        if (ReferenceEquals(current, _request)) return;
        _cts?.Cancel();
        _request = current;
        if (current is null) return;
        _left = Math.Max(0, current.Seconds);
        _cts = new CancellationTokenSource();
        _ = Countdown(_cts.Token);
    }

    private async Task Countdown(CancellationToken ct)
    {
        while (_left > 0)
        {
            try { await Task.Delay(1000, ct); } catch (TaskCanceledException) { return; }
            _left--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Close() => Overlay.Complete(_left <= 0);
    private void Finish() => Overlay.Complete(true);

    private static string RewardText(RewardKind r) => r switch
    {
        RewardKind.StreakFreeze => "Streak freeze",
        RewardKind.ExtraQuest => "Bonus quest",
        _ => "Perfect-play review",
    };

    /// <inheritdoc />
    public void Dispose() { Overlay.Changed -= OnChanged; _cts?.Cancel(); _cts?.Dispose(); }
}
