@* Root component for both hosts: Router + AuthGate + NotFound, plus app-wide hosts (theme, ads, toasts). *@
@inject TttJsModule Js
@inject IJSRuntime JSRuntime
@inject ISoundService Sound

<SettingsApplier />
<AuthGate>
    <Router AppAssembly="typeof(Routes).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(AppShell)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(AppShell)">
                <NotFoundPage />
            </LayoutView>
        </NotFound>
    </Router>
</AuthGate>
<DeepLinkHandler />
<MatchFoundNavigator />
<NotificationHost />
<AdOverlayHost />
<ToastHost />

@code {
    /// <inheritdoc />
    protected override void OnInitialized() => Js.Attach(JSRuntime);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Sound.InitAsync();
    }
}
