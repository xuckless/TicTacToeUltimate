@* Root component for both hosts: Router + AuthGate + NotFound, plus app-wide hosts (theme, ads, toasts). *@
@inject TttJsModule Js
@inject IJSRuntime JSRuntime
@inject ISoundService Sound
@inject Localizer Loc
@implements IDisposable

<SettingsApplier />
@* Re-keyed on a language change so every component renders its text again. *@
<AuthGate @key="Loc.Language">
    <Router AppAssembly="typeof(Routes).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(AppShell)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(AppShell)">
                <NotFoundPage />
            </LayoutView>
        </NotFound>
    </Router>
</AuthGate>
<DeepLinkHandler />
<MatchFoundNavigator />
<NotificationHost />
<AdOverlayHost />
<ToastHost />
<DiagnosticsHost />

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Js.Attach(JSRuntime);
        Loc.Changed += OnLanguage;
    }

    private void OnLanguage() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose() => Loc.Changed -= OnLanguage;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Sound.InitAsync();
    }
}
