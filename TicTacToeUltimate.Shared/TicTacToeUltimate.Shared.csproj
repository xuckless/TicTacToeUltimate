<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TicTacToeUltimate.Shared</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TicTacToeUltimate.Client\TicTacToeUltimate.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>
  <ItemGroup>
    <!-- English is always in the assembly (fallback + first render); other languages are fetched from _content/…/i18n/. -->
    <EmbeddedResource Include="wwwroot/i18n/en.json" LogicalName="i18n.en.json" />
  </ItemGroup>
</Project>
