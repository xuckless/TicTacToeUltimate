@page "/signin"
@layout PlainLayout
@inherits StoreComponent
@inject ISessionStore Session
@inject NavigationManager Nav

<PageTitle>Sign in · Tic Tac Toe Ultimate</PageTitle>
<div class="t-col" style="padding:0;align-items:stretch">
    <h1 class="signin-logo" style="text-align:center;margin:0"><BounceText Text="Tic Tac Toe" Class="sub" /><br /><BounceText Text="Ultimate" Class="ultimate" /></h1>
    <p class="t-muted" style="text-align:center;margin:0">Pieces vanish. Every game ends in a win.</p>

    @if (_step == Step.Landing)
    {
        @* Log in is the main door; creating an account is the same email code, so it is a quiet link (owner decision 2026-10-16). *@
        @if (EmailAuth)
        {
            <Button Variant="primary" Block="true" OnClick="() => Start(create: false)" Disabled="_busy" data-testid="login">Log in</Button>
        }
        @if (!Session.State.IsGuest)
        {
            <Button Variant="secondary" Block="true" OnClick="Guest" Disabled="_busy" data-testid="guest">Play as guest</Button>
        }
        else
        {
            <p class="t-small t-muted" style="text-align:center;margin:0" data-testid="guest-keep">Your guest games, streak and quests move into your account when you sign in.</p>
        }
        @if (EmailAuth)
        {
            <p class="t-small t-muted signin-create" style="text-align:center;margin:0">New here? <button type="button" class="t-link-btn" @onclick="() => Start(create: true)" data-testid="create-account">Create account</button></p>
        }
    }
    else if (EmailAuth)
    {
        <Card Title="@CardTitle" Class="email-card">
            @if (_step == Step.Email)
            {
                <p class="t-small t-muted" style="margin:0">@(_create ? "Enter your email and we'll send a 6-digit code. Then pick a username and you're in." : "Enter your email and we'll send a 6-digit code. No password to remember.")</p>
                <TextField Label="Email" Type="email" Value="@_email" ValueChanged="v => _email = v" Placeholder="you@example.com" MaxLength="254" OnEnter="SendCode" />
                <Button Variant="primary" Block="true" OnClick="SendCode" Disabled="@(_busy || !_email.Contains('@'))" data-testid="email-submit">Send code</Button>
                <button type="button" class="t-link-btn" @onclick="Back">Back</button>
            }
            else
            {
                <p class="t-small t-muted" style="margin:0">Sent to <strong>@_email.Trim()</strong>. Type the code, or just tap the link in the email. Check spam if it takes a minute.</p>
                <TextField Label="6-digit code" Type="text" Value="@_code" ValueChanged="v => _code = new string(v.Where(char.IsDigit).Take(6).ToArray())" Placeholder="123456" MaxLength="6"
                           OnEnter="VerifyCode" />
                <Button Variant="primary" Block="true" OnClick="VerifyCode" Disabled="@(_busy || _code.Length != 6)" data-testid="code-submit">@(_create ? "Create account" : "Log in")</Button>
                <div class="t-spread">
                    <button type="button" class="t-link-btn" @onclick="ChangeEmail">Use a different email</button>
                    <button type="button" class="t-link-btn" disabled="@(_resendIn > 0 || _busy)" @onclick="SendCode">@(_resendIn > 0 ? $"Resend in {_resendIn}s" : "Resend code")</button>
                </div>
            }
            @if (_info is not null) { <p class="t-small email-info" role="status"><Bert Mood="wink" Size="34" /> @_info</p> }
        </Card>
        <p class="t-small t-muted" style="text-align:center;margin:0">
            @if (_create) { <span>Already have an account? <button type="button" class="t-link-btn" @onclick="() => Switch(create: false)">Log in</button></span> }
            else { <span>New here? <button type="button" class="t-link-btn" @onclick="() => Switch(create: true)">Create account</button></span> }
        </p>
    }
    @if (Session.State.Config?.DevAuth == true)
    {
        <Card Title="Dev sign-in">
            @if (_users.Count == 0) { <span class="t-small t-muted">@(_loading ? "Loading dev users…" : "No dev users.")</span> }
            @foreach (var u in _users)
            {
                <button type="button" class="t-listrow" style="background:none;border:0;border-bottom:1px solid var(--line);width:100%;text-align:left;cursor:pointer;color:inherit;min-height:48px"
                        @onclick="() => SignIn(u.UserId)" disabled="@_busy">
                    <Avatar Name="@u.DisplayName" />
                    <span class="who"><span class="name">@u.DisplayName</span> <BotBadge Kind="u.Kind" /><br /><span class="meta">@Ui.TierName(u.Tier)@(u.Rating is int r ? $" · {r}" : "")</span></span>
                </button>
            }
            <TextField Label="Create dev user" Placeholder="username" Value="@_newName" ValueChanged="v => _newName = v" OnEnter="Create" MaxLength="16"
                       Error="@(_newName.Length > 0 && !OnboardingPage.IsValidUsername(_newName) ? "3–16 chars: a–z, 0–9, _" : null)" />
            <Button Variant="secondary" OnClick="Create" Disabled="@(_busy || !OnboardingPage.IsValidUsername(_newName))">Create and sign in</Button>
        </Card>
    }
    @if (_error is not null) { <p class="t-alert" role="alert">@_error</p> }
</div>

@code {
    private enum Step { Landing, Email, Code }
    private Step _step = Step.Landing;
    private bool _create;
    private string _email = "", _code = "";
    private string? _info;
    private int _resendIn;
    private List<DevUserDto> _users = [];
    private string _newName = "";
    private bool _busy, _loading = true;
    private string? _error;

    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }
    /// <summary>"login" or "create" skips the landing and opens the email step directly.</summary>
    [SupplyParameterFromQuery(Name = "mode")] private string? Mode { get; set; }

    private bool EmailAuth => Session.State.Config?.SupabaseAuth == true;
    private string CardTitle => _step == Step.Code ? "Enter your code" : _create ? "Create your account" : "Welcome back";

    private void Start(bool create) { _create = create; _step = Step.Email; _error = null; _info = null; }
    private void Switch(bool create) { _create = create; if (_step == Step.Code) ChangeEmail(); }
    private void Back() { _step = Step.Landing; _error = null; _info = null; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Session);
        if (Mode is "login" or "create") Start(Mode == "create");
        // Older confirmation links land here with the session in the URL fragment: still honoured.
        var uri = new Uri(Nav.Uri);
        if (uri.Fragment.Contains("access_token=", StringComparison.Ordinal))
        {
            _busy = true;
            var ok = await Session.CompleteRedirectAsync(uri.Fragment);
            _busy = false;
            Nav.NavigateTo(Nav.Uri.Split('#')[0], replace: true);
            if (!ok) _error = "That link has expired. Sign in with a code instead.";
            else { Done(); return; }
        }
        else if (uri.Fragment.Contains("error_description=", StringComparison.Ordinal))
        {
            _error = "That link has expired or was already used. Sign in with a code instead.";
        }
        if (Session.State.Config?.DevAuth == true)
        {
            try { _users = (await Session.GetDevUsersAsync()).ToList(); }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
        }
        _loading = false;
    }

    /// <inheritdoc />
    protected override void OnStoresChanged()
    {
        if (Session.State.Status == SessionStatus.SignedIn && !Session.State.IsGuest && !_busy) Done();
    }

    private async Task SendCode()
    {
        if (!_email.Contains('@') || _busy || _resendIn > 0) return;
        _busy = true; _error = null; _info = null;
        try
        {
            _error = await Session.SendCodeAsync(_email);
            if (_error is null) { _step = Step.Code; _code = ""; _info = "Code sent! It's valid for 10 minutes."; _ = Countdown(); }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException) { _error = "Can't reach the server. Try again."; }
        finally { _busy = false; }
    }

    private async Task Countdown()
    {
        for (_resendIn = 30; _resendIn > 0; _resendIn--)
        {
            await Task.Delay(1000);
            if (IsDisposed) return;
            StateHasChanged();
        }
    }

    private void ChangeEmail() { _step = Step.Email; _code = ""; _info = null; _error = null; }

    private async Task VerifyCode()
    {
        if (_code.Length != 6 || _busy) return;
        _busy = true; _error = null; _info = null;
        try { _error = await Session.VerifyCodeAsync(_email, _code); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException) { _error = "Can't reach the server. Try again."; }
        finally { _busy = false; }
        if (_error is null && Session.State.Status == SessionStatus.SignedIn && !Session.State.IsGuest) Done();
    }

    private Task Guest() => Run(Session.SignInGuestAsync);
    private Task SignIn(Guid id) => Run(() => Session.SignInDevAsync(id));
    private Task Create() => OnboardingPage.IsValidUsername(_newName) ? Run(() => Session.SignInDevNewUserAsync(_newName)) : Task.CompletedTask;

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _error = "Sign-in failed. Is the server running?"; }
        finally { _busy = false; }
        if (Session.State.Status == SessionStatus.SignedIn) Done();
        else _error ??= Session.State.Error ?? "Sign-in failed.";
    }

    private void Done()
    {
        var target = ReturnUrl is { Length: > 1 } r && r.StartsWith('/') && !r.StartsWith("//", StringComparison.Ordinal) ? r.TrimStart('/') : "";
        Nav.NavigateTo(target, replace: true);
    }
}
