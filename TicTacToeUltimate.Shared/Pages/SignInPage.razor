@page "/signin"
@layout PlainLayout
@inherits StoreComponent
@inject ISessionStore Session
@inject NavigationManager Nav

<PageTitle>Sign in · Tic Tac Toe Ultimate</PageTitle>
<div class="t-col" style="padding:0;align-items:stretch">
    <h1 class="signin-logo" style="text-align:center;margin:0"><BounceText Text="Tic Tac Toe" Class="sub" /><br /><BounceText Text="Ultimate" Class="ultimate" /></h1>
    <p class="t-muted" style="text-align:center;margin:0">Pieces vanish. Every game ends in a win.</p>

    @if (_recovery)
    {
        <Card Title="Set a new password">
            <TextField Label="New password" Type="password" Value="@_password" ValueChanged="v => _password = v" OnEnter="SetPassword" MaxLength="72"
                       Hint="At least 8 characters." />
            <Button Variant="primary" Block="true" OnClick="SetPassword" Disabled="@(_busy || _password.Length < 8)">Save password</Button>
        </Card>
    }
    else
    {
    @if (!Session.State.IsGuest)
    {
        <Button Variant="primary" Block="true" OnClick="Guest" Disabled="_busy" data-testid="guest">Play as guest</Button>
    }
    else
    {
        <p class="t-small t-muted" style="text-align:center;margin:0" data-testid="guest-keep">Your guest games, streak and quests move into your account when you sign in.</p>
    }

    @if (Session.State.Config?.SupabaseAuth == true)
    {
        <Card Title="@(_mode == "Create account" ? "Create your account" : _mode == "Forgot" ? "Reset your password" : "Sign in")" Class="email-card">
            @if (_mode != "Forgot")
            {
                <Tabs Items="EmailModes" Active="@_mode" ActiveChanged="SetMode" Label="Sign in or create an account" />
            }
            <TextField Label="Email" Type="email" Value="@_email" ValueChanged="v => _email = v" Placeholder="you@example.com" MaxLength="254"
                       OnEnter="SubmitEmail" />
            @if (_mode != "Forgot")
            {
                <TextField Label="Password" Type="password" Value="@_password" ValueChanged="v => _password = v" OnEnter="SubmitEmail" MaxLength="72"
                           Hint="@(_mode == "Create account" ? "At least 8 characters." : null)" />
            }
            <Button Variant="primary" Block="true" OnClick="SubmitEmail" Disabled="@(_busy || !EmailReady)" data-testid="email-submit">
                @(_mode == "Create account" ? "Create account" : _mode == "Forgot" ? "Send reset link" : "Sign in")
            </Button>
            @if (_mode == "Sign in") { <button type="button" class="t-link-btn" @onclick="@(() => SetMode("Forgot"))">Forgot password?</button> }
            @if (_mode == "Forgot") { <button type="button" class="t-link-btn" @onclick="@(() => SetMode("Sign in"))">Back to sign in</button> }
            @if (_info is not null) { <p class="t-small email-info" role="status"><Bert Mood="wink" Size="34" /> @_info</p> }
        </Card>
    }
    }

    @if (Session.State.Config?.DevAuth == true)
    {
        <Card Title="Dev sign-in">
            @if (_users.Count == 0) { <span class="t-small t-muted">@(_loading ? "Loading dev users…" : "No dev users.")</span> }
            @foreach (var u in _users)
            {
                <button type="button" class="t-listrow" style="background:none;border:0;border-bottom:1px solid var(--line);width:100%;text-align:left;cursor:pointer;color:inherit;min-height:48px"
                        @onclick="() => SignIn(u.UserId)" disabled="@_busy">
                    <Avatar Name="@u.DisplayName" />
                    <span class="who"><span class="name">@u.DisplayName</span> <BotBadge Kind="u.Kind" /><br /><span class="meta">@Ui.TierName(u.Tier)@(u.Rating is int r ? $" · {r}" : "")</span></span>
                </button>
            }
            <TextField Label="Create dev user" Placeholder="username" Value="@_newName" ValueChanged="v => _newName = v" OnEnter="Create" MaxLength="16"
                       Error="@(_newName.Length > 0 && !OnboardingPage.IsValidUsername(_newName) ? "3–16 chars: a–z, 0–9, _" : null)" />
            <Button Variant="secondary" OnClick="Create" Disabled="@(_busy || !OnboardingPage.IsValidUsername(_newName))">Create and sign in</Button>
        </Card>
    }
    @if (_error is not null) { <p class="t-alert" role="alert">@_error</p> }
</div>

@code {
    private static readonly string[] EmailModes = ["Sign in", "Create account"];
    private string _mode = "Sign in", _email = "", _password = "";
    private string? _info;
    private bool _recovery;
    private List<DevUserDto> _users = [];
    private string _newName = "";
    private bool _busy, _loading = true;
    private string? _error;

    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Session);
        // Email confirmation / password recovery links land here with the session in the URL fragment.
        var uri = new Uri(Nav.Uri);
        if (uri.Fragment.Contains("access_token=", StringComparison.Ordinal))
        {
            _recovery = uri.Fragment.Contains("type=recovery", StringComparison.Ordinal);
            _busy = true;
            var ok = await Session.CompleteRedirectAsync(uri.Fragment);
            _busy = false;
            Nav.NavigateTo(Nav.Uri.Split('#')[0], replace: true);
            if (!ok) { _recovery = false; _error = "That link has expired. Sign in, or ask for a new link."; }
            else if (!_recovery) { Done(); return; }
        }
        else if (uri.Fragment.Contains("error_description=", StringComparison.Ordinal))
        {
            _error = "That link has expired or was already used. Sign in, or ask for a new link.";
        }
        if (Session.State.Config?.DevAuth == true)
        {
            try { _users = (await Session.GetDevUsersAsync()).ToList(); }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
        }
        _loading = false;
    }

    /// <inheritdoc />
    protected override void OnStoresChanged()
    {
        if (Session.State.Status == SessionStatus.SignedIn && !Session.State.IsGuest && !_busy && !_recovery) Done();
    }

    private void SetMode(string mode) { _mode = mode; _error = null; _info = null; }

    private bool EmailReady => _email.Contains('@') && (_mode == "Forgot" || _password.Length >= (_mode == "Create account" ? 8 : 1));

    private async Task SubmitEmail()
    {
        if (!EmailReady || _busy) return;
        _busy = true; _error = null; _info = null;
        try
        {
            switch (_mode)
            {
                case "Forgot":
                    _error = await Session.ResetPasswordAsync(_email);
                    if (_error is null) _info = "Check your inbox for a reset link.";
                    break;
                case "Create account":
                    var (confirm, err) = await Session.SignUpEmailAsync(_email, _password);
                    _error = err;
                    if (err is null && confirm) { _info = $"Almost there! We sent a confirmation link to {_email.Trim()}. Open it to finish."; _mode = "Sign in"; }
                    break;
                default:
                    _error = await Session.SignInEmailAsync(_email, _password);
                    break;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException) { _error = "Can't reach the server. Try again."; }
        finally { _busy = false; }
        if (_error is null && Session.State.Status == SessionStatus.SignedIn && !Session.State.IsGuest) Done();
    }

    private async Task SetPassword()
    {
        if (_password.Length < 8 || _busy) return;
        _busy = true;
        _error = await Session.SetPasswordAsync(_password);
        _busy = false;
        if (_error is null) { _recovery = false; Done(); }
    }

    private Task Guest() => Run(Session.SignInGuestAsync);
    private Task SignIn(Guid id) => Run(() => Session.SignInDevAsync(id));
    private Task Create() => OnboardingPage.IsValidUsername(_newName) ? Run(() => Session.SignInDevNewUserAsync(_newName)) : Task.CompletedTask;

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _error = "Sign-in failed. Is the server running?"; }
        finally { _busy = false; }
        if (Session.State.Status == SessionStatus.SignedIn) Done();
        else _error ??= Session.State.Error ?? "Sign-in failed.";
    }

    private void Done()
    {
        var target = ReturnUrl is { Length: > 1 } r && r.StartsWith('/') && !r.StartsWith("//", StringComparison.Ordinal) ? r.TrimStart('/') : "";
        Nav.NavigateTo(target, replace: true);
    }
}
