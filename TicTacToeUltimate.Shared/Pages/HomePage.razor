@page "/"
@inherits StoreComponent
@inject ISessionStore Session
@inject IProgressStore Progress
@inject ISocialStore Social
@inject IWalletStore Wallet
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Tic Tac Toe Ultimate</PageTitle>

<header class="home-header">
    <span style="display:flex;gap:6px;align-items:center"><StreakPill Count="@(Progress.State.Progress?.Streak.Current ?? 0)" AtRisk="@(Progress.State.Progress?.Streak.AtRisk ?? false)" Freezes="@(Progress.State.Progress?.Streak.FreezesBanked ?? 0)" /><DiamondPill /></span>
    <h1 class="brand" style="margin:0"><BounceText Text="Tic Tac Toe" /> <BounceText Text="Ultimate" Class="ultimate" /></h1>
    <a class="t-iconbtn t-iconbtn--round" href="settings" aria-label="@L.T("appShell.settings")"><Icon Name="settings" /></a>
</header>

<ActiveGames />
<PlayHero Rating="RankedRating" Guest="IsGuest" Subtitle="@(IsGuest ? L.T("home.unrated_15s_per_move") : L.T("home.placement_games"))" />
<ModeGrid DailyYourTurn="Session.State.DailyYourTurn" Guest="IsGuest" />
@if (!IsGuest && Session.State.DailyYourTurn > 0)
{
    <a class="daily-nudge" href="daily"><Icon Name="calendar" /><span>@((MarkupString)L.F("home.daily_your_move", Session.State.DailyYourTurn))</span><Icon Name="next" /></a>
}
<div class="mode-wrap">
    <a class="mode-btn local-entry" href="local" data-testid="home-passplay">
        <Icon Name="passplay" Class="mode-ico" /><span class="t-label">@L.T("localSetup.pass_play")</span><span class="sub">@L.T("home.one_device_offline")</span>
    </a>
    <InfoButton Key="passplay" Class="corner" />
</div>
<QuestCard Progress="Progress.State.Progress" NowMs="NowMs" OnExtraQuest="ExtraQuest" />
@if (!IsGuest)
{
    <FriendsOnlineRow Friends="Social.State.Friends" />
}
else
{
    <Card Title="@L.T("home.save_your_progress")">
        <p class="t-small t-muted" style="margin:0">@L.T("home.create_an_account_for_ranked")</p>
        <AccountCta Variant="secondary" />
    </Card>
}
<AdSlot />

@code {
    private bool IsGuest => Session.State.IsGuest;
    private RatingDto? RankedRating => Session.State.Me?.Ratings.FirstOrDefault(r => r.Pool == RatingPools.Headline);
    private static long NowMs => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Session, Progress, Social);
        var tasks = new List<Task> { Progress.LoadAsync() };
        if (!IsGuest) tasks.Add(Social.LoadAsync());
        try { await Task.WhenAll(tasks); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { Toasts.Show(L.T("home.couldn_t_load_everything"), ToastKind.Error); }
    }

    private async Task ExtraQuest()
    {
        // Perks are bought with Diamonds (50); ads earn Diamonds in the Store.
        var r = await Wallet.BuyAsync("extra-quest");
        if (r.Ok) Toasts.Show(L.T("home.bonus_quest_unlocked"), ToastKind.Success);
        else if (r.Error == ErrorCodes.InsufficientDiamonds) { Toasts.Show(L.T("home.the_bonus_quest_costs"), ToastKind.Info); Nav.NavigateTo("store"); }
        else Toasts.Show(Ui.ErrorToastText(r.Error, L.T("home.couldn_t_unlock_the_bonus")), ToastKind.Error);
    }
}
