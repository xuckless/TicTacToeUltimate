@page "/replay/{Id:guid}"
@inject IGameQueries Queries
@inject IProgressStore Progress
@inject IWalletStore Wallet
@inject ToastService Toasts
@implements IDisposable

<PageTitle>Replay · Tic Tac Toe Ultimate</PageTitle>
<h1 class="t-title">Replay</h1>

@if (_game is null)
{
    @if (_loading) { <BertLoader Text="Loading game" Mood="think" /> } else { <p class="t-muted">Game not found.</p> }
}
else
{
    var frame = _frames[_ply];
    var final = _ply == _frames.Count - 1;
    <p class="t-small t-muted" style="margin:0">
        @string.Join(" vs ", _game.Seats.Select(s => s.Player.DisplayName)) · @Ui.TimeControlName(_game.TimeControl) · @Ui.ReasonText(_game.Result.Reason)
    </p>
    <div style="display:grid;place-items:center">
        <Board Size="_game.Rules.BoardSize" Cells="@frame.Board" Ghost="@(final ? null : frame.Ghost)" LastPlaced="frame.LastPlaced"
               WinLine="@(final ? _game.Result.WinLine : null)" Winner="Winner" Interactive="false" />
    </div>
    <ReplayScrubber Ply="_ply" Max="_frames.Count - 1" PlyChanged="p => Seek(p)" />
    <div class="replay-controls" aria-label="Playback">
        <Button Variant="@(_playing ? "secondary" : "primary")" Small="true" OnClick="TogglePlay" data-testid="replay-play"><Icon Name="@(_playing ? "close" : "play")" /> @(_playing ? "Pause" : _ply >= _frames.Count - 1 ? "Replay from start" : "Play")</Button>
        <div class="t-seg" role="group" aria-label="Speed">
            @foreach (var sp in new[] { 1, 2, 4, 8 })
            {
                <button type="button" aria-pressed="@(_speed == sp ? "true" : "false")" @onclick="() => _speed = sp">@(sp)×</button>
            }
        </div>
        <span class="t-small t-muted">@(_ply > 0 && _ply <= _frames.Count - 1 ? $"thought {Ui.Elapsed(_frames[_ply].ThinkMs)}" : "as it happened")</span>
    </div>
    @if (_analysis is null && AnalysisPossible)
    {
        <Card Title="Perfect-play review">
            <p class="t-small t-muted" style="margin:0">@(_analysisError ?? "See which moves won and which were blunders.")</p>
            @if (_unlocked)
            {
                <Button Variant="secondary" OnClick="LoadAnalysis" Disabled="_busy">Try again</Button>
            }
            else
            {
                <Button Variant="primary" OnClick="Unlock" Disabled="_busy"><Icon Name="diamond" /> Unlock · 20</Button>
                <a class="t-small" href="store">Need Diamonds? Earn them in the Store</a>
            }
        </Card>
    }
    <MoveList Actions="_game.Actions" Current="_ply" Analysis="_analysis?.Plies" OnSelect="p => _ply = p" Size="_game.Rules.BoardSize" />
}

@code {
    private GameRecordDto? _game;
    private IReadOnlyList<ReplayFrame> _frames = [];
    private GameAnalysisDto? _analysis;
    private string? _analysisError;
    private int _ply;
    private bool _loading = true, _busy, _unlocked, _playing;
    private int _speed = 1;
    private CancellationTokenSource? _playCts;

    /// <summary>Clash-Royale-style playback: each move appears after the time the player actually took (capped at 8 s, divided by the speed).</summary>
    private async Task TogglePlay()
    {
        if (_playing) { Stop(); return; }
        if (_ply >= _frames.Count - 1) _ply = 0;
        _playing = true;
        var cts = _playCts = new CancellationTokenSource();
        try
        {
            while (_ply < _frames.Count - 1 && !cts.IsCancellationRequested)
            {
                var wait = Math.Clamp(_frames[_ply + 1].ThinkMs, 400, 8000) / _speed;
                await Task.Delay(wait, cts.Token);
                _ply++;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        if (ReferenceEquals(_playCts, cts)) { _playing = false; StateHasChanged(); }
    }

    private void Stop() { _playCts?.Cancel(); _playCts = null; _playing = false; }
    private void Seek(int p) { Stop(); _ply = p; }

    /// <inheritdoc />
    public void Dispose() => Stop();

    /// <summary>The tablebase covers classic 3x3 games only: not Arena (scoring layer), not Old school, not aborted games.</summary>
    private bool AnalysisPossible => _game is not null && _game.Result.Reason != EndReason.Aborted && _game.Actions.Length > 0
        && !TicTacToeUltimate.Engine.Clocks.MoveClock.IsArena(_game.TimeControl) && _game.TimeControl != TicTacToeUltimate.Engine.Clocks.TimeControl.OldSchool;

    /// <summary>Game id.</summary>
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "analysis")] private int? AnalysisFlag { get; set; }

    private Color? Winner => _game?.Result.Outcome switch { Outcome.XWins => Color.X, Outcome.OWins => Color.O, _ => null };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try { _game = await Queries.GetGameAsync(Id); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
        _loading = false;
        if (_game is null) return;
        var arena = TicTacToeUltimate.Engine.Clocks.MoveClock.IsArena(_game.TimeControl) ? TicTacToeUltimate.Engine.Arena.ArenaRules.RulesetC with { Board = _game.Rules.ToEngine() } : null;
        _frames = ReplayFrames.Build(_game.Rules, _game.Actions, arena);
        _ply = _frames.Count - 1;
        // Already unlocked (earlier ad, or the result screen) → show it without asking for another ad.
        if (AnalysisPossible) await LoadAnalysis();
    }

    private async Task LoadAnalysis()
    {
        var (a, err) = await Queries.GetAnalysisAsync(Id);
        _analysis = a;
        if (a is not null || err is ErrorCodes.AnalysisWarming) _unlocked = true;   // the grant exists; no second ad
        _analysisError = err switch
        {
            null => null,
            ErrorCodes.AnalysisWarming => "Analysis is warming up. Try again in a moment.",
            ErrorCodes.RewardRequired => null,
            _ => "Analysis isn't available for this game.",
        };
    }

    private async Task Unlock()
    {
        _busy = true;
        try
        {
            var r = await Wallet.BuyAsync("analysis", Id);
            if (r.Ok || r.Error == ErrorCodes.ItemUnavailable) await LoadAnalysis();
            else if (r.Error == ErrorCodes.InsufficientDiamonds) Toasts.Show("The review costs 20 Diamonds. Win games or watch an ad in the Store.", ToastKind.Info);
            else Toasts.Show(Ui.ErrorToastText(r.Error, "Couldn't unlock the review."), ToastKind.Error);
        }
        finally { _busy = false; }
    }
}
