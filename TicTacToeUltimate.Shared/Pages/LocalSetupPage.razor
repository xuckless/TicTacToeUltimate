@page "/local"
@using TicTacToeUltimate.Client.Local
@inject LocalPlaySession Local
@inject NavigationManager Nav

<PageTitle>@L.T("localSetup.page_title")</PageTitle>
<header class="pp-hero">
    <div class="pp-hero-text">
        <h1 class="play-title"><BounceText Text="@L.T("localSetup.pass_play")" /></h1>
        <p class="pp-tag">@L.T("localSetup.two_players_one_device_works")</p>
    </div>
    <Bert Mood="jumpy" Size="76" Class="pp-bert" />
    <InfoButton Key="passplay" Class="pp-info" />
</header>

@if (Local.Current is { } cur)
{
    <a class="pp-resume" href="local/play" data-testid="local-current">
        <span class="pp-resume-score"><span class="x">@cur.NameOf(0)</span> <b class="t-num">@cur.Score[0] – @cur.Score[1]</b> <span class="o">@cur.NameOf(1)</span></span>
        <span class="t-small t-muted">@(cur.IsLive ? L.F("localSetup.game_in_progress", cur.GameNumber) : L.F("localSetup.played", cur.GameNumber))</span>
        <span class="pp-resume-go">@(cur.IsLive ? L.T("resumeBanner.resume") : L.T("localSetup.back_to_board")) <Icon Name="next" /></span>
    </a>
}

<section class="pp-versus" aria-label="@L.T("localSetup.players")">
    <label class="pp-player x">
        <span class="pp-piece" aria-hidden="true">X</span>
        <span class="pp-role">@L.T("localSetup.starts")</span>
        <input class="pp-name" value="@_p1" @oninput="e => _p1 = e.Value?.ToString() ?? string.Empty" placeholder="@L.T("localSetup.player_1")"
               maxlength="@LocalGameOptions.MaxNameLength" aria-label="@L.T("localSetup.player_1_name")" />
    </label>
    <span class="pp-vs" aria-hidden="true">@L.T("localSetup.vs")</span>
    <label class="pp-player o">
        <span class="pp-piece" aria-hidden="true">O</span>
        <span class="pp-role">@L.T("localSetup.second")</span>
        <input class="pp-name" value="@_p2" @oninput="e => _p2 = e.Value?.ToString() ?? string.Empty" placeholder="@L.T("localSetup.player_2")"
               maxlength="@LocalGameOptions.MaxNameLength" aria-label="@L.T("localSetup.player_2_name")" @onkeydown="Enter" />
    </label>
</section>
<p class="t-small t-muted pp-note">@L.T("localSetup.colours_swap_every_rematch")</p>

<section class="mode-group" aria-label="@L.T("challengeModePicker.mode")">
    <h2 class="mode-group-title">@L.T("challengeModePicker.mode")</h2>
    <div class="pp-tiles" role="radiogroup" aria-label="@L.T("challengeModePicker.mode")">
        @foreach (var c in Clocks)
        {
            var on = _tc == c.Tc;
            <div class="mode-wrap">
                <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" class="pp-tile @(on ? "on" : null)" style="--accent:@c.Accent"
                        data-testid="@($"tc-{c.Tc}")" @onclick="() => Pick(c.Tc)">
                    <span class="mode-art" aria-hidden="true"><Icon Name="@c.Icon" /></span>
                    <span class="pp-tile-name">@c.Name</span>
                    <span class="pp-tile-sub">@c.Sub</span>
                    @if (on) { <span class="pp-check" aria-hidden="true"><Icon Name="check" /></span> }
                    <LocalBurst Trigger="@(_burstTc == c.Tc ? _burst : 0)" Color="@c.Accent" />
                </button>
                <InfoButton Key="@c.Guide" Class="corner" />
            </div>
        }
    </div>
</section>

@if (_tc != TimeControl.ArenaCasual)
{
<section class="mode-group" aria-label="@L.T("localSetup.rules")">
    <h2 class="mode-group-title">@L.T("localSetup.rules")</h2>
    <div class="pp-tiles" role="radiogroup" aria-label="@L.T("localSetup.rules")">
        @foreach (var p in Presets)
        {
            var on = _preset == p.Preset;
            <div class="mode-wrap">
                <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" class="pp-tile slim @(on ? "on" : null)" style="--accent:@p.Accent"
                        data-testid="@($"rules-{p.Preset}")" @onclick="() => _preset = p.Preset">
                    <span class="pp-glyph" aria-hidden="true">@p.Glyph</span>
                    <span class="pp-tile-name">@p.Name</span>
                    <span class="pp-tile-sub">@p.Sub</span>
                    @if (on) { <span class="pp-check" aria-hidden="true"><Icon Name="check" /></span> }
                </button>
                <InfoButton Key="@p.Guide" Class="corner" />
            </div>
        }
    </div>
    <div class="pie-row pp-pie">
        <label class="t-toggle">
            <span><strong>@L.T("localSetup.pie_rule")</strong><br /><span class="t-small t-muted">@L.T("localSetup.player_2_may_take_the")</span></span>
            <input type="checkbox" checked="@_pie" @onchange="e => _pie = e.Value is true" data-testid="pie" />
        </label>
        <InfoButton Key="pie" />
    </div>
</section>
}

<div class="pp-start">
    <Button Variant="hero" Block="true" OnClick="Start" data-testid="local-start">@(Local.Current is null ? L.T("localSetup.let_s_play") : L.T("localSetup.start_new_session"))</Button>
</div>

@code {
    private sealed record ClockOption(TimeControl Tc, string Name, string Sub, string Guide, string Icon, string Accent);
    private sealed record PresetOption(LocalRulePreset Preset, string Name, string Sub, string Guide, string Glyph, string Accent);

    private static PresetOption[] Presets =>
    [
        new(LocalRulePreset.Classic, L.T("localSetup.ultimate"), L.T("localSetup.3_pieces_each"), "classic", "3", "#7442ef"),
        new(LocalRulePreset.OldSchool, L.T("modeGrid.old_school"), L.T("localSetup.no_vanishing"), "oldschool", "#", "#1fb5a0"),
        new(LocalRulePreset.Legacy7, L.T("localSetup.legacy"), L.T("localSetup.7_piece_prototype"), "legacy7", "7", "#8b8aa6"),
    ];
    private LocalRulePreset _preset = LocalRulePreset.Classic;

    private static ClockOption[] Clocks =>
    [
        new(TimeControl.Unlimited, L.T("localSetup.unlimited"), L.T("localSetup.no_clock"), "unlimited", "unlimited", "#8a6cff"),
        new(TimeControl.Casual, L.T("modeGrid.casual"), L.T("localSetup.15s_clock"), "casual", "casual", "#2f9be0"),
        new(TimeControl.ArenaCasual, L.T("modeGrid.arena"), L.T("localSetup.health_bars"), "arena", "arena", "#e0457b"),
    ];

    private string _p1 = "", _p2 = "";
    private TimeControl _tc = TimeControl.Unlimited;
    private bool _pie;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Local.Current?.Options is { } o)
        {
            _p1 = o.Player1 == LocalGameOptions.DefaultPlayer1 ? "" : o.Player1;
            _p2 = o.Player2 == LocalGameOptions.DefaultPlayer2 ? "" : o.Player2;
            _tc = o.TimeControl;
            _pie = o.Pie;
            _preset = o.Preset;
        }
    }

    private TimeControl? _burstTc;
    private int _burst;

    private void Pick(TimeControl tc) { _tc = tc; _burstTc = tc; _burst++; }

    private void Enter(KeyboardEventArgs e) { if (e.Key == "Enter") Start(); }

    private void Start()
    {
        if (_tc == TimeControl.ArenaCasual)
        {
            Local.StartArena(_p1, _p2);
            Nav.NavigateTo("local/arena");
            return;
        }
        Local.Start(new LocalGameOptions { Player1 = _p1, Player2 = _p2, TimeControl = _tc, Pie = _pie, Preset = _preset });
        Nav.NavigateTo("local/play");
    }
}
