@page "/c/{Code}"
@inherits StoreComponent
@inject ISessionStore Session
@inject ISocialStore Social
@inject NavigationManager Nav

<PageTitle>@L.T("challenge.challenge_tic_tac_toe_ultimate")</PageTitle>
<h1 class="t-title">@L.T("challengeCard.challenge")</h1>

@if (_loading)
{
    <BertLoader Text="@L.T("challenge.loading_challenge")" Mood="wave" />
}
else if (_challenge is null || _challenge.Status != ChallengeStatus.Open)
{
    <Card><p style="margin:0">@(_challenge is null ? L.T("challenge.this_challenge_doesn_t_exist") : L.T("challenge.this_challenge_is_no_longer"))</p></Card>
    <Button Variant="secondary" Href="">@L.T("crashPanel.home")</Button>
}
else
{
    <Card>
        <div class="t-listrow" style="border:0">
            <Avatar Name="@_challenge.From.DisplayName" AvatarId="@_challenge.From.AvatarId" Size="md" />
            <div class="who"><div class="name">@_challenge.From.DisplayName</div>
                <div class="meta">@L.F("challenge.unrated_meta", Ui.TimeControlName(_challenge.TimeControl)) <TierBadge Tier="_challenge.From.Tier" /></div></div>
        </div>
        <span class="t-small t-muted">@L.F("challenge.code", _challenge.Code)</span>
    </Card>
    @if (_error is not null) { <p class="t-alert" role="alert">@_error</p> }
    @if (Session.State.Status == SessionStatus.SignedIn)
    {
        <Button Variant="primary" Block="true" OnClick="Accept" Disabled="_busy">@L.T("challenge.accept_challenge")</Button>
        <Button Variant="secondary" Block="true" OnClick="Decline" Disabled="_busy">@L.T("challengeCard.decline")</Button>
    }
    else
    {
        <Button Variant="primary" Block="true" OnClick="PlayAsGuest" Disabled="_busy">@L.T("challenge.play_as_guest")</Button>
        <Button Variant="secondary" Block="true" Href="@($"signin?mode=login&returnUrl={Uri.EscapeDataString($"/c/{Code}")}")">@L.T("accountCta.log_in")</Button>
    }
}

@code {
    private ChallengeDto? _challenge;
    private bool _loading = true, _busy;
    private string? _error;

    /// <summary>Challenge code.</summary>
    [Parameter] public string Code { get; set; } = "";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Session);
        try { _challenge = await Social.GetChallengeAsync(Code); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
        _loading = false;
    }

    private async Task PlayAsGuest()
    {
        _busy = true;
        try { await Session.SignInGuestAsync(); await Accept(); }
        catch (Exception ex) { _error = ErrorText.Code(ex) == "offline" ? L.T("challenge.can_t_reach_the_server") : L.T("challenge.couldn_t_join_as_a"); }
        finally { _busy = false; }
    }

    private async Task Accept()
    {
        _busy = true;
        try
        {
            AcceptChallengeResultDto r;
            try { r = await Social.AcceptChallengeAsync(Code); }
            catch (Exception ex) { r = new AcceptChallengeResultDto(false, ErrorText.Code(ex), null); }
            if (r.Accepted && r.MatchId is Guid id) Nav.NavigateTo($"match/{id}");
            else _error = r.Error switch
            {
                ErrorCodes.ChallengeTaken => L.T("challenge.someone_else_already_accepted"),
                ErrorCodes.ChallengeExpired => L.T("challenge.this_challenge_expired"),
                ErrorCodes.CannotChallengeSelf => L.T("challenge.that_s_your_own_challenge"),
                ErrorCodes.GuestNotAllowed => L.T("challenge.this_game_needs_an_account"),
                ErrorCodes.AlreadyInMatch => L.T("challenge.finish_your_current_game_first"),
                ErrorCodes.ServerUpdating => Ui.ServerUpdatingText,
                "offline" => L.T("challenge.can_t_reach_the_server"),
                _ => L.T("challenge.couldn_t_accept_the_challenge"),
            };
        }
        finally { _busy = false; }
    }

    private async Task Decline()
    {
        await Social.DeclineChallengeAsync(Code);
        Nav.NavigateTo("");
    }
}
