@page "/leaderboards"
@inject IGameQueries Queries
@inject ISessionStore Session

<PageTitle>@L.T("leaderboards.leaderboards_tic_tac_toe_ultimate")</PageTitle>
<h1 class="t-title">@L.T("appShell.leaderboards")</h1>

@if (!Session.State.IsGuest)
{
    <Tabs Items="Scopes" Active="@_scope" ActiveChanged="SetScope" Label="@L.T("leaderboards.scope")" Caption="ScopeCaption" />
}

@if (Session.State.IsGuest)
{
    <Card><p style="margin:0">@((MarkupString)L.T("leaderboards.guest_cta"))</p></Card>
}
else if (_error)
{
    <Card><div class="t-empty"><Bert Mood="shocked" Size="64" /><span>@L.T("leaderboards.couldn_t_load_the_leaderboard")</span><Button Variant="secondary" Small="true" OnClick="Load">@L.T("authGate.retry")</Button></div></Card>
}
else if (_page is null)
{
    <BertLoader Text="@L.T("leaderboards.loading_leaderboard")" />
}
else
{
    <section aria-label="@L.T("leaderboards.rankings")">
        @if (_page.Rows.Length == 0) { <p class="t-muted t-small">@L.T("leaderboards.nobody_here_yet")</p> }
        @foreach (var (row, i) in _page.Rows.Select((r, i) => (r, i))) { <LeaderboardRow Row="row" IsMe="@(row.Player.UserId == Session.State.Me?.UserId)" />@if (Ui.FeedAdAfter(i)) { <AdSlot Kind="AdSlotKind.Feed" /> } }
        @if (_page.Me is { } me && _page.Rows.All(r => r.Player.UserId != me.Player.UserId))
        {
            <div style="height:12px"></div>
            <LeaderboardRow Row="me" IsMe="true" />
        }
    </section>
    <div class="t-spread">
        <Button Variant="secondary" Small="true" Disabled="@(_pageNo <= 1)" OnClick="() => Go(_pageNo - 1)">@L.T("leaderboards.previous")</Button>
        <span class="t-small t-muted">@L.F("leaderboards.page", _pageNo)</span>
        <Button Variant="secondary" Small="true" Disabled="@(_pageNo * _page.PageSize >= _page.TotalCount)" OnClick="() => Go(_pageNo + 1)">@L.T("leaderboards.next")</Button>
    </div>
}
<AdSlot />

@code {
    private static readonly string[] Scopes = ["Global", "Friends", "Country", "Master"];
    private string _scope = "Global";
    private static string ScopeCaption(string s) => L.T($"leaderboards.scope.{s.ToLowerInvariant()}");
    private RatingPool _pool = RatingPools.Headline;
    private int _pageNo = 1;
    private LeaderboardPageDto? _page;
    private bool _error;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => Session.State.IsGuest ? Task.CompletedTask : Load();

    private async Task Load()
    {
        var scope = _scope switch { "Friends" => LeaderboardScope.Friends, "Country" => LeaderboardScope.Country, "Master" => LeaderboardScope.MasterSeason, _ => LeaderboardScope.Global };
        var country = scope == LeaderboardScope.Country ? Session.State.Me?.Country : null;
        _error = false;
        try { _page = await Queries.GetLeaderboardAsync(_pool, scope, country, _pageNo); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _page = null; _error = true; }
    }

    private Task SetScope(string s) { _scope = s; _pageNo = 1; return Load(); }
    private Task SetPool(RatingPool p) { _pool = p; _pageNo = 1; return Load(); }
    private Task Go(int p) { _pageNo = p; return Load(); }
}
