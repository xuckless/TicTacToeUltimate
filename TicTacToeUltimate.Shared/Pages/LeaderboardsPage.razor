@page "/leaderboards"
@inject IGameQueries Queries
@inject ISessionStore Session

<PageTitle>Leaderboards · TTT Ultimate</PageTitle>
<h1 class="t-title">Leaderboards</h1>

<Tabs Items="Scopes" Active="@_scope" ActiveChanged="SetScope" Label="Scope" />
<div class="t-seg" role="group" aria-label="Pool">
    <button type="button" aria-pressed="@(_pool == RatingPool.Ranked ? "true" : "false")" @onclick="() => SetPool(RatingPool.Ranked)">Ranked</button>
    <button type="button" aria-pressed="@(_pool == RatingPool.Daily ? "true" : "false")" @onclick="() => SetPool(RatingPool.Daily)">Daily</button>
    <button type="button" aria-pressed="@(_pool == RatingPool.ArenaRanked ? "true" : "false")" @onclick="() => SetPool(RatingPool.ArenaRanked)">Arena</button>
</div>

@if (Session.State.IsGuest)
{
    <Card><p style="margin:0">Leaderboards are for accounts. <a href="signin">Create one</a> to get ranked.</p></Card>
}
else if (_page is null)
{
    <p class="t-muted">Loading…</p>
}
else
{
    <section aria-label="Rankings">
        @if (_page.Rows.Length == 0) { <p class="t-muted t-small">Nobody here yet.</p> }
        @foreach (var row in _page.Rows) { <LeaderboardRow Row="row" IsMe="@(row.Player.UserId == Session.State.Me?.UserId)" /> }
        @if (_page.Me is { } me && _page.Rows.All(r => r.Player.UserId != me.Player.UserId))
        {
            <div style="height:12px"></div>
            <LeaderboardRow Row="me" IsMe="true" />
        }
    </section>
    <div class="t-spread">
        <Button Variant="secondary" Small="true" Disabled="@(_pageNo <= 1)" OnClick="() => Go(_pageNo - 1)">Previous</Button>
        <span class="t-small t-muted">Page @_pageNo</span>
        <Button Variant="secondary" Small="true" Disabled="@(_pageNo * _page.PageSize >= _page.TotalCount)" OnClick="() => Go(_pageNo + 1)">Next</Button>
    </div>
}
<AdSlot />

@code {
    private static readonly string[] Scopes = ["Global", "Friends", "Country", "Master"];
    private string _scope = "Global";
    private RatingPool _pool = RatingPool.Ranked;
    private int _pageNo = 1;
    private LeaderboardPageDto? _page;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => Session.State.IsGuest ? Task.CompletedTask : Load();

    private async Task Load()
    {
        var scope = _scope switch { "Friends" => LeaderboardScope.Friends, "Country" => LeaderboardScope.Country, "Master" => LeaderboardScope.MasterSeason, _ => LeaderboardScope.Global };
        var country = scope == LeaderboardScope.Country ? Session.State.Me?.Country : null;
        try { _page = await Queries.GetLeaderboardAsync(_pool, scope, country, _pageNo); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _page = null; }
    }

    private Task SetScope(string s) { _scope = s; _pageNo = 1; return Load(); }
    private Task SetPool(RatingPool p) { _pool = p; _pageNo = 1; return Load(); }
    private Task Go(int p) { _pageNo = p; return Load(); }
}
