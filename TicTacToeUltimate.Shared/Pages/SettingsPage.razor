@page "/settings"
@inherits StoreComponent
@inject ISettingsStore Settings
@inject ISessionStore Session
@inject NavigationManager Nav
@inject ToastService Toasts
@inject TicTacToeUltimate.Client.Abstractions.ClientOptions Options

<PageTitle>Settings · Tic Tac Toe Ultimate</PageTitle>
<h1 class="t-title">Settings</h1>

<Card Title="Look">
    <span class="t-label">Theme</span>
    <div class="t-seg" role="group" aria-label="Theme">
        @foreach (var t in Enum.GetValues<ThemePreference>())
        {
            <button type="button" aria-pressed="@(S.Theme == t ? "true" : "false")" @onclick="() => Update(s => s with { Theme = t })">@t</button>
        }
    </div>
    <span class="t-label">Motion</span>
    <div class="t-seg" role="group" aria-label="Motion">
        @foreach (var m in Enum.GetValues<MotionPreference>())
        {
            <button type="button" aria-pressed="@(S.Motion == m ? "true" : "false")" @onclick="() => Update(s => s with { Motion = m })">@m</button>
        }
    </div>
    <label class="t-toggle"><span>Impact frames</span><input type="checkbox" checked="@S.ImpactFrames" @onchange="e => Update(s => s with { ImpactFrames = On(e) })" /></label>
</Card>

<Card Title="Sound and feel">
    <label class="t-toggle"><span>Sound effects</span><input type="checkbox" checked="@S.Sfx" @onchange="e => Update(s => s with { Sfx = On(e) })" /></label>
    <label class="t-toggle"><span>SFX volume</span><input type="range" min="0" max="100" value="@((int)(S.SfxVolume * 100))" aria-label="SFX volume" @onchange="e => Update(s => s with { SfxVolume = Vol(e) })" /></label>
    <label class="t-toggle"><span>Music</span><input type="checkbox" checked="@S.Music" @onchange="e => Update(s => s with { Music = On(e) })" /></label>
    <label class="t-toggle"><span>Music volume</span><input type="range" min="0" max="100" value="@((int)(S.MusicVolume * 100))" aria-label="Music volume" @onchange="e => Update(s => s with { MusicVolume = Vol(e) })" /></label>
    <label class="t-toggle"><span>Haptics</span><input type="checkbox" checked="@S.Haptics" @onchange="e => Update(s => s with { Haptics = On(e) })" /></label>
</Card>

<Card Title="Gameplay">
    <div style="display:flex;align-items:center;gap:8px">
        <label class="t-toggle" style="flex:1"><span>Guided mode</span><input type="checkbox" checked="@S.ThreatHints" @onchange="e => Update(s => s with { ThreatHints = On(e) })" /></label>
        <InfoButton Key="guided" />
    </div>
    <label class="t-toggle"><span>Mute opponent emotes</span><input type="checkbox" checked="@S.MuteOpponentEmotes" @onchange="e => Update(s => s with { MuteOpponentEmotes = On(e) })" /></label>
</Card>

<Card Title="Account">
    @if (Session.State.Me is { } me)
    {
        <div class="t-listrow" style="border:0">
            <Avatar Name="@me.DisplayName" AvatarId="@me.AvatarId" />
            <div class="who"><div class="name">@me.DisplayName</div><div class="meta">@(me.Kind == AccountKind.Guest ? "Guest" : me.RenamesLeft > 0 ? "1 free rename left" : "Account")</div></div>
        </div>
        @if (me.Kind == AccountKind.Guest) { <AccountCta /> }
        else { <Button Variant="secondary" Href="onboarding">Edit profile</Button> }
    }
    <Button Variant="danger" OnClick="SignOut">Sign out</Button>
    @if (Session.State.Me is not null)
    {
        <button type="button" class="t-linkbtn t-small t-muted" style="margin-top:8px;background:none;border:0;cursor:pointer;color:inherit;text-decoration:underline" @onclick="() => _confirmDelete = true" data-testid="delete-account">Delete my account…</button>
    }
</Card>

<Card Title="About">
    <div class="t-small t-muted">Tic Tac Toe Ultimate @Options.ClientVersion</div>
    <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:6px">
        <a href="@Web("privacy/")" target="_blank" rel="noopener">Privacy policy</a>
        <a href="@Web("terms/")" target="_blank" rel="noopener">Terms of service</a>
        <a href="@Web("how-to-play/")" target="_blank" rel="noopener">How to play</a>
        <a href="mailto:hello@alidirect.dev">Contact</a>
    </div>
</Card>

<Sheet Open="_confirmDelete" Title="Delete account?" OnClose="() => _confirmDelete = false">
    <p class="t-body">This removes your @(Session.State.Me?.Kind == AccountKind.Guest ? "guest profile" : "account"), ratings, streak, quests, friends and messages right away. Finished games stay in your opponents' history as "Deleted player". This cannot be undone.</p>
    <div style="display:grid;gap:10px;margin-top:12px">
        <Button Variant="danger" Block="true" Disabled="_deleting" OnClick="DeleteAccount" data-testid="confirm-delete">@(_deleting ? "Deleting…" : "Delete everything")</Button>
        <Button Variant="secondary" Block="true" OnClick="() => _confirmDelete = false">Keep my account</Button>
    </div>
</Sheet>

@code {
    private SettingsState S => Settings.State;
    private bool _confirmDelete, _deleting;

    private string Web(string path) => new Uri(Options.WebBaseUrl, path).ToString();

    private async Task DeleteAccount()
    {
        _deleting = true;
        var error = await Session.DeleteAccountAsync();
        _deleting = false;
        if (error is not null) { Toasts.Show(error == ErrorCodes.RateLimited ? "Too many attempts. Try again in a minute." : "Couldn't delete your account. Check your connection and try again.", ToastKind.Error); return; }
        _confirmDelete = false;
        Toasts.Show("Your account was deleted.", ToastKind.Success);
        Nav.NavigateTo("signin", replace: true);
    }

    /// <inheritdoc />
    protected override void OnInitialized() => Subscribe(Settings, Session);

    private Task Update(Func<SettingsState, SettingsState> f) => Settings.UpdateAsync(f);
    private static bool On(ChangeEventArgs e) => e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var v) && v;
    private static double Vol(ChangeEventArgs e) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? Math.Clamp(v / 100, 0, 1) : 0.5;

    private async Task SignOut()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("signin", replace: true);
    }
}
