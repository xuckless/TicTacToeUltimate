@page "/settings"
@inherits StoreComponent
@inject ISettingsStore Settings
@inject ISessionStore Session
@inject NavigationManager Nav

<PageTitle>Settings · TTT Ultimate</PageTitle>
<h1 class="t-title">Settings</h1>

<Card Title="Look">
    <span class="t-label">Theme</span>
    <div class="t-seg" role="group" aria-label="Theme">
        @foreach (var t in Enum.GetValues<ThemePreference>())
        {
            <button type="button" aria-pressed="@(S.Theme == t ? "true" : "false")" @onclick="() => Update(s => s with { Theme = t })">@t</button>
        }
    </div>
    <span class="t-label">Motion</span>
    <div class="t-seg" role="group" aria-label="Motion">
        @foreach (var m in Enum.GetValues<MotionPreference>())
        {
            <button type="button" aria-pressed="@(S.Motion == m ? "true" : "false")" @onclick="() => Update(s => s with { Motion = m })">@m</button>
        }
    </div>
    <label class="t-toggle"><span>Impact frames</span><input type="checkbox" checked="@S.ImpactFrames" @onchange="e => Update(s => s with { ImpactFrames = On(e) })" /></label>
</Card>

<Card Title="Sound and feel">
    <label class="t-toggle"><span>Sound effects</span><input type="checkbox" checked="@S.Sfx" @onchange="e => Update(s => s with { Sfx = On(e) })" /></label>
    <label class="t-toggle"><span>SFX volume</span><input type="range" min="0" max="100" value="@((int)(S.SfxVolume * 100))" aria-label="SFX volume" @onchange="e => Update(s => s with { SfxVolume = Vol(e) })" /></label>
    <label class="t-toggle"><span>Music</span><input type="checkbox" checked="@S.Music" @onchange="e => Update(s => s with { Music = On(e) })" /></label>
    <label class="t-toggle"><span>Music volume</span><input type="range" min="0" max="100" value="@((int)(S.MusicVolume * 100))" aria-label="Music volume" @onchange="e => Update(s => s with { MusicVolume = Vol(e) })" /></label>
    <label class="t-toggle"><span>Haptics</span><input type="checkbox" checked="@S.Haptics" @onchange="e => Update(s => s with { Haptics = On(e) })" /></label>
</Card>

<Card Title="Gameplay">
    <label class="t-toggle"><span>Guided mode <InfoButton Key="guided" /></span><input type="checkbox" checked="@S.ThreatHints" @onchange="e => Update(s => s with { ThreatHints = On(e) })" /></label>
    <label class="t-toggle"><span>Mute opponent emotes</span><input type="checkbox" checked="@S.MuteOpponentEmotes" @onchange="e => Update(s => s with { MuteOpponentEmotes = On(e) })" /></label>
</Card>

<Card Title="Account">
    @if (Session.State.Me is { } me)
    {
        <div class="t-listrow" style="border:0">
            <Avatar Name="@me.DisplayName" AvatarId="@me.AvatarId" />
            <div class="who"><div class="name">@me.DisplayName</div><div class="meta">@(me.Kind == AccountKind.Guest ? "Guest" : me.RenamesLeft > 0 ? "1 free rename left" : "Account")</div></div>
        </div>
        @if (me.Kind == AccountKind.Guest) { <Button Variant="primary" Href="signin">Create account</Button> }
        else if (me.RenamesLeft > 0) { <Button Variant="secondary" Href="onboarding">Edit profile</Button> }
    }
    <Button Variant="danger" OnClick="SignOut">Sign out</Button>
</Card>

@code {
    private SettingsState S => Settings.State;

    /// <inheritdoc />
    protected override void OnInitialized() => Subscribe(Settings, Session);

    private Task Update(Func<SettingsState, SettingsState> f) => Settings.UpdateAsync(f);
    private static bool On(ChangeEventArgs e) => e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var v) && v;
    private static double Vol(ChangeEventArgs e) => double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? Math.Clamp(v / 100, 0, 1) : 0.5;

    private async Task SignOut()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("signin", replace: true);
    }
}
