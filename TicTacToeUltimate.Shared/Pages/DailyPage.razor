@page "/daily"
@inject IGameQueries Queries
@inject IQueueStore Queue
@inject NavigationManager Nav

<PageTitle>Daily · Tic Tac Toe Ultimate</PageTitle>
<div class="t-spread"><h1 class="t-title">Daily</h1><Button Variant="primary" Small="true" OnClick="NewGame" Disabled="@(_games.Count >= 10)">New game</Button></div>
<p class="t-small t-muted" style="margin:0">24 hours per move. Up to 10 games at once.</p>

@if (_loading)
{
    <BertLoader Text="Loading daily games" />
}
else if (_error)
{
    <Card><div class="t-empty"><Bert Mood="shocked" Size="64" /><span>Couldn't load your daily games.</span><Button Variant="secondary" Small="true" OnClick="Load">Retry</Button></div></Card>
}
else if (_games.Count == 0)
{
    <Card><div class="t-empty"><Bert Mood="sleepy" Size="64" /><span>No daily games yet. Start one and play at your own pace.</span></div></Card>
}
else
{
    <section class="t-card" style="padding:4px 16px">
        @foreach (var g in _games)
        {
            <a class="t-listrow" href="@($"match/{g.MatchId}")" style="color:inherit;text-decoration:none">
                <Avatar Name="@g.Opponent.DisplayName" AvatarId="@g.Opponent.AvatarId" />
                <div class="who"><div class="name">@g.Opponent.DisplayName</div>
                    <div class="meta">You play <PieceGlyph Color="g.YourColor" /> · move @(g.Ply + 1)@DeadlineText(g)</div></div>
                @if (g.YourTurn) { <span class="t-chip" style="color:var(--success)">Your move</span> } else { <span class="t-small t-muted">Waiting</span> }
            </a>
        }
    </section>
}
<AdSlot />

@code {
    private List<DailyGameDto> _games = [];
    private bool _loading = true, _error;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true; _error = false;
        try
        {
            var all = await Queries.GetDailyGamesAsync();
            _games = all.OrderByDescending(g => g.YourTurn).ThenBy(g => g.DeadlineAtMs ?? long.MaxValue).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _error = true; }
        _loading = false;
    }

    private static string DeadlineText(DailyGameDto g)
    {
        if (g.DeadlineAtMs is not long d) return "";
        var left = TimeSpan.FromMilliseconds(Math.Max(0, d - DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()));
        return left.TotalHours >= 1 ? $" · {(int)left.TotalHours}h left" : $" · {Math.Max(1, (int)left.TotalMinutes)}m left";
    }

    private async Task NewGame()
    {
        await Queue.EnterAsync(TimeControl.Daily);
        Nav.NavigateTo("play");
    }
}
