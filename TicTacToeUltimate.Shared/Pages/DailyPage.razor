@page "/daily"
@inject IGameQueries Queries
@inject IQueueStore Queue
@inject ISessionStore Session
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>@L.T("daily.daily_tic_tac_toe_ultimate")</PageTitle>
<div class="t-spread"><h1 class="t-title">@L.T("friendRow.daily")</h1>@if (!Session.State.IsGuest) { <Button Variant="primary" Small="true" OnClick="NewGame" Disabled="@(_games.Count >= 10 || _starting)">@L.T("daily.new_game")</Button> }</div>
<p class="t-small t-muted" style="margin:0">@L.T("daily.24_hours_per_move_up")</p>

@if (Session.State.IsGuest)
{
    <Card Title="@L.T("daily.daily_games_need_an_account")"><p class="t-small t-muted" style="margin:0">@L.T("daily.create_an_account_to_play")</p><AccountCta /></Card>
}
else if (_loading)
{
    <BertLoader Text="@L.T("daily.loading_daily_games")" />
}
else if (_error)
{
    <Card><div class="t-empty"><Bert Mood="shocked" Size="64" /><span>@L.T("daily.couldn_t_load_your_daily")</span><Button Variant="secondary" Small="true" OnClick="Load">@L.T("authGate.retry")</Button></div></Card>
}
else if (_games.Count == 0)
{
    <Card><div class="t-empty"><Bert Mood="sleepy" Size="64" /><span>@L.T("daily.no_daily_games_yet_start")</span></div></Card>
}
else
{
    <section class="t-card" style="padding:4px 16px">
        @foreach (var g in _games)
        {
            <a class="t-listrow" href="@($"match/{g.MatchId}")" style="color:inherit;text-decoration:none">
                <Avatar Name="@g.Opponent.DisplayName" AvatarId="@g.Opponent.AvatarId" />
                <div class="who"><div class="name">@g.Opponent.DisplayName</div>
                    <div class="meta">@L.T("daily.you_play") <PieceGlyph Color="g.YourColor" /> @L.F("activeGames.move", g.Ply + 1)@DeadlineText(g)</div></div>
                @if (g.YourTurn) { <span class="t-chip" style="color:var(--success)">@L.T("activeGames.your_move")</span> } else { <span class="t-small t-muted">@L.T("daily.waiting")</span> }
            </a>
        }
    </section>
}
<AdSlot />

@code {
    private List<DailyGameDto> _games = [];
    private bool _loading = true, _error;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => Session.State.IsGuest ? Task.CompletedTask : Load();

    private async Task Load()
    {
        _loading = true; _error = false;
        try
        {
            var all = await Queries.GetDailyGamesAsync();
            _games = all.OrderByDescending(g => g.YourTurn).ThenBy(g => g.DeadlineAtMs ?? long.MaxValue).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _error = true; }
        _loading = false;
    }

    private static string DeadlineText(DailyGameDto g)
    {
        if (g.DeadlineAtMs is not long d) return "";
        var left = TimeSpan.FromMilliseconds(Math.Max(0, d - DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()));
        return " · " + (left.TotalHours >= 1 ? L.F("common.hours_left", (int)left.TotalHours) : L.F("common.minutes_left", Math.Max(1, (int)left.TotalMinutes)));
    }

    private bool _starting;

    private async Task NewGame()
    {
        _starting = true;
        try
        {
            await Queue.EnterAsync(TimeControl.Daily);
            if (Queue.State is { Phase: QueuePhase.Idle, Error: { } err }) { Toasts.Show(Ui.ErrorToastText(err, L.T("daily.couldn_t_start_a_daily")), ToastKind.Error); return; }
            Nav.NavigateTo("play");
        }
        finally { _starting = false; }
    }
}
