@page "/match/{Id:guid}"
@layout MatchLayout
@inherits StoreComponent
@inject TicTacToeUltimate.Shared.Services.AmbienceService Ambience
@using TicTacToeUltimate.Shared.Services
@inject IMatchStore Matches
@inject ISessionStore Session
@inject ISettingsStore Settings
@inject NavigationManager Nav

<PageTitle>@(_view?.IsMyTurn == true && _view.Result is null ? "Your move · " : "")TTT Ultimate</PageTitle>

@if (_view is null)
{
    <div class="splash" role="status">@(_error ?? "Loading match…")</div>
    @if (_error is not null) { <div style="display:grid;place-items:center"><Button Href="">Home</Button></div> }
}
else
{
    var snap = _view.Snapshot;
    var me = MySeatDto;
    var opp = OppSeatDto;
    var sd = InSuddenDeath;
    <div class="match @AlertClass" data-testid="match">
        <ConnectionBanner Phase="Session.State.Connection" Attempt="Session.State.ReconnectAttempt" Resyncing="_view.Resyncing" />
        <MatchHeader Mode="snap.Mode" TimeControl="snap.TimeControl" Clock="_clock" Spectators="snap.SpectatorCount" />
        <h1 class="sr-only">Match vs @(opp?.Player.DisplayName ?? "opponent")</h1>
        @if (IsArena && !Ended)
        {
            <ArenaBanner RemainingMs="RoundLeft" RedAlert="ArenaRed" Multiplier="ArenaRulesDto!.RedAlertMultiplier" RedAlertMs="ArenaRulesDto.RedAlertMs"
                         Overtime="@(ArenaDto?.Overtime ?? false)" FirstMover="OvertimeFirstName" />
        }

        <PlayerCard Seat="opp" Piece="@(opp?.Color ?? Color.O)" Active="@IsActive(opp)" SuddenDeath="sd" Urgency="UrgencyFor(opp)"
                    ClockMs="ClockFor(opp)" ShowClock="HasClock" LongClock="IsDaily" Ended="Ended" Emote="@EmoteFor(opp)" />
        @if (IsArena && opp is not null) { <HealthBar @key="@($"hp{opp.Seat}")" Hp="HpOf(opp.Seat)" Max="ArenaRulesDto!.Hp" TickEvery="TickEvery" Piece="opp.Color" Label="@opp.Player.DisplayName"
                                                      Preview="PreviewOn(opp.Seat)" Streak="StreakOf(opp.Seat)" Steps="ArenaRulesDto.Ramp.Length"
                                                      ComboBroken="@(_brokenSeat == opp.Seat)" Hit="@(HitOn(opp.Seat))" HitKey="_hitKey" /> }

        <div class="match-board">
            <ThreatCallout Visible="@(_view.ThreatCells.Length > 0 && CanMove)" />
            <div class="arena-board-wrap @HitStopClass">
            <Board Size="snap.Rules.BoardSize" Cells="@snap.Board" Ghost="Ghost" Aging="Aging" WinLine="@(IsArena ? null : snap.Result?.WinLine ?? _view.Result?.WinLine)"
                   Winner="Winner" Threats="_view.ThreatCells" Legal="snap.LegalCells" Interactive="CanMove"
                   Pending="_view.PendingCell" PendingColor="me?.Color" LastPlaced="LastPlaced" SuddenDeath="@(sd || ArenaRed)" OnCellSelected="Place" OnBlockedSelected="Blocked" />
            @if (IsArena && _hit is { } hit)
            {
                <ShatterBurst Size="snap.Rules.BoardSize" Cells="hit.Shattered" Piece="ColorOfSeat(hit.Seat)" Damage="hit.Damage" Crit="hit.Crit"
                              RedAlert="hit.RedAlert" Ply="hit.Ply" />
            }
            </div>
            <div class="match-hint" data-testid="match-hint">
                @if (BlockedText is { } bt)
                {
                    <span class="match-hint-blocked" role="alert">@bt</span>
                }
                else
                {
                    var (mover, waiting) = HintText;
                    if (mover is not null) { <span>@mover</span> }
                    if (mover is not null && waiting is not null) { <br /> }
                    if (waiting is not null) { <span class="match-hint-sub">@waiting</span> }
                }
            </div>
            @if (_view.LastError is not null) { <div class="t-alert t-small" role="alert">@ErrorText(_view.LastError)</div> }
        </div>

        @if (IsArena && me is not null) { <HealthBar @key="@($"hp{me.Seat}")" Hp="HpOf(me.Seat)" Max="ArenaRulesDto!.Hp" TickEvery="TickEvery" Piece="me.Color" Label="@(_view.IsSpectator ? me.Player.DisplayName : "You")"
                                                     Preview="PreviewOn(me.Seat)" Streak="StreakOf(me.Seat)" Steps="ArenaRulesDto.Ramp.Length"
                                                     ComboBroken="@(_brokenSeat == me.Seat)" Hit="@(HitOn(me.Seat))" HitKey="_hitKey" /> }
        <PlayerCard Seat="me" IsMe="@(!_view.IsSpectator)" Piece="@(me?.Color ?? Color.X)" Active="@IsActive(me)" SuddenDeath="sd" Urgency="UrgencyFor(me)"
                    ClockMs="ClockFor(me)" ShowClock="HasClock" LongClock="IsDaily" Ended="Ended" Emote="@EmoteFor(me)"
                    WindowSeconds="@(_clock?.AllowanceMs is int a ? Ui.Seconds(a) : null)" />

        @if (sd && !Ended) { <SuddenDeathBar Clock="_clock" /> }
        <MatchActions Disabled="_view.IsSpectator" Ended="Ended" OnEmote="() => _emotes = true" OnResign="() => _resign = true" OnMenu="() => _menu = true" />
        <div class="sr-only" aria-live="polite">@Announcement</div>
    </div>

    <SwapDecisionSheet Open="SwapOpen" OnDecide="Decide" />
    <EmotePicker Open="_emotes" Emotes="Session.State.Config?.Emotes" OnPick="Emote" OnClose="() => _emotes = false" />
    <ResignSheet Open="_resign" Rated="snap.Rated" OnConfirm="Resign" OnClose="() => _resign = false" />
    <MatchMenuSheet Open="_menu" Settings="Settings.State" OnSettings="UpdateSettings" OnLeave="Leave" OnClose="() => _menu = false"
                    Ended="Ended" Spectator="_view.IsSpectator" />

    @if (Ended && _showOverlay)
    {
        <div class="match-over" role="dialog" aria-modal="true" aria-label="Game over">
            <div class="t-card">
                <span class="t-label">@Ui.ReasonText(_view.Result!.Reason)</span>
                <span class="t-hero"><BounceText Text="@ResultTitle" /></span>
                @if (_view.IsSpectator) { <Button Variant="secondary" OnClick="Leave">Leave</Button> }
                else { <Button OnClick="GoToResult">Continue</Button> }
            </div>
        </div>
    }

    <ImpactFrame Kind="@_impactKind" Text="@_impactText" Token="@_impactToken" Trigger="_impactTrigger" DurationMs="_impactDuration" />
}

@code {
    private MatchView? _view;
    private ClockView? _clock;
    private string? _error;
    private bool _emotes, _resign, _menu, _showOverlay;
    private bool? _prevSd;
    private bool _resultHandled, _sawLive;
    private int _impactTrigger;
    private string _impactKind = "win", _impactText = "", _impactToken = "alert-fill";
    private int _impactDuration = 1400;
    // Arena: last animated hit, hit-stop replay counter, combo-break target, phase cues already shown.
    private bool _arenaInit, _redSeen, _otSeen;
    private int _lastHitPly = -1, _hitKey;
    private int? _brokenSeat;
    private ArenaHitDto? _hit;
    private CancellationTokenSource? _navCts;

    /// <summary>Match id.</summary>
    [Parameter] public Guid Id { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Matches, Session, Settings);
        Matches.ClockTick += OnTick;
        _view = Matches.State.Matches.GetValueOrDefault(Id);
        if (_view is null)
        {
            try { _view = await Matches.OpenAsync(Id); }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _error = "Couldn't open this match."; }
            _view ??= Matches.State.Matches.GetValueOrDefault(Id);
            if (_view is null) _error ??= "Match not found.";
        }
        _sawLive = _view is { Result: null };
        Derive();
    }

    /// <inheritdoc />
    protected override void OnStoresChanged()
    {
        _view = Matches.State.Matches.GetValueOrDefault(Id) ?? _view;
        if (_view is { Result: null }) _sawLive = true;
        Derive();
    }

    private void OnTick() => _ = InvokeAsync(() =>
    {
        if (IsDisposed) return;
        Derive();
        StateHasChanged();
    });

    private void Derive()
    {
        if (_view is null) return;
        _clock = Matches.GetClock(Id);
        var sd = InSuddenDeath;
        Ambience.Set(AmbienceMode.Match, sd, Ended ? ClockUrgency.Idle : _clock?.Urgency ?? ClockUrgency.Idle);
        if (_prevSd == false && sd && !Ended) Impact("suddendeath", "SUDDEN DEATH", "alert-fill");
        _prevSd = sd;
        DeriveArena();

        if (_view.Result is not null && !_resultHandled)
        {
            _resultHandled = true;
            var slammed = false;
            if (_sawLive && !_view.IsSpectator)
            {
                var r = MyResult;
                if (r == GameResultForUser.Win) slammed = Impact("win", "VICTORY!", Winner == Color.O ? "piece-o" : "piece-x");
                else if (r == GameResultForUser.Loss) slammed = Impact("loss", "DEFEAT", "alert-fill");
                _navCts = new CancellationTokenSource();
                _ = NavigateToResultLater(_navCts.Token);
            }
            // The impact frame already slams the headline; show the result overlay only after it, so the title never appears twice.
            if (slammed) _ = RevealOverlayLater(_impactDuration);
            else _showOverlay = true;
        }

        if (_view.RematchMatchId is Guid next && next != Id) Nav.NavigateTo($"match/{next}");
    }

    private bool Impact(string kind, string text, string token, int durationMs = 1400)
    {
        if (!Settings.State.ImpactFrames) return false;
        _impactKind = kind; _impactText = text; _impactToken = token; _impactDuration = durationMs;
        _impactTrigger++;
        return true;
    }

    private async Task RevealOverlayLater(int ms)
    {
        await Task.Delay(ms);
        _showOverlay = true;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Arena cues: shatter impact frame + hit-stop, rare crit, combo break, red alert, overtime. Old hits are not replayed on open.</summary>
    private void DeriveArena()
    {
        if (!IsArena) return;
        var a = ArenaDto;
        var h = a?.LastHit;
        if (!_arenaInit)
        {
            _arenaInit = true;
            _lastHitPly = h?.Ply ?? -1;
            _redSeen = ArenaRed;
            _otSeen = a?.Overtime ?? false;
            return;
        }
        if (h is not null && h.Ply != _lastHitPly)
        {
            _lastHitPly = h.Ply;
            _hit = h;
            _hitKey++;
            _brokenSeat = h.BrokenStreak > 0 ? 1 - h.Seat : null;
            var token = ColorOfSeat(h.Seat) == Color.O ? "piece-o" : "piece-x";
            if (h.Crit) Impact("crit", $"CRITICAL! −{h.Damage}", token, 1600);
            else Impact("shatter", $"−{h.Damage}{(h.RedAlert ? " ×2" : "")}", token, 650);
        }
        else if (_brokenSeat is not null && h is null) _brokenSeat = null;
        if (ArenaRed && !_redSeen) { _redSeen = true; Impact("redalert", "RED ALERT ×2", "alert-fill"); }
        if (a?.Overtime == true && !_otSeen && !Ended) { _otSeen = true; Impact("suddendeath", "OVERTIME", "alert-fill"); }
    }

    // ---- arena view ----
    private ArenaRulesDto? ArenaRulesDto => _view?.Snapshot.ArenaRules;
    private ArenaStateDto? ArenaDto => _view?.Snapshot.Arena;
    private bool IsArena => ArenaRulesDto is not null;
    private int TickEvery => ArenaRulesDto is { Ramp.Length: > 0 } r ? r.Ramp[0] : 25;
    private int ArenaElapsed => _clock?.GameElapsedMs ?? ArenaDto?.ElapsedMs ?? 0;
    private bool ArenaRed => IsArena && !Ended && ArenaDto?.Overtime != true && ArenaRulesDto!.RedAlertMultiplier > 1
                             && ArenaElapsed >= ArenaRulesDto.RoundMs - ArenaRulesDto.RedAlertMs;
    private int RoundLeft => ArenaRulesDto is { } r ? Math.Max(0, r.RoundMs - ArenaElapsed) : 0;
    private int HpOf(int seat) => ArenaDto?.Hp.ElementAtOrDefault(seat) ?? ArenaRulesDto?.Hp ?? 0;
    private int StreakOf(int seat) => ArenaDto?.Streak.ElementAtOrDefault(seat) ?? 0;
    private Color ColorOfSeat(int seat) => _view?.Snapshot.Seats.FirstOrDefault(s => s.Seat == seat)?.Color ?? (seat == 0 ? Color.X : Color.O);
    private bool HitOn(int seat) => _hit is { } h && h.Seat != seat && _hitKey > 0 && h.Ply == _lastHitPly;
    private string HitStopClass => _hitKey == 0 ? "" : $"hs-{_hitKey % 2}{(_hit?.Crit == true ? " hs-crit" : "")}";

    /// <summary>Red-alert ghost segment on the victim's bar: the attacker's next line damage, doubled.</summary>
    private int PreviewOn(int seat)
    {
        if (!ArenaRed || ArenaDto is not { } a || ArenaRulesDto is not { } r) return 0;
        var raw = a.NextLineDamage.ElementAtOrDefault(1 - seat);
        var baseDmg = a.RedAlert ? raw / Math.Max(1, r.RedAlertMultiplier) : raw;
        return baseDmg * r.RedAlertMultiplier;
    }

    private string? OvertimeFirstName => ArenaDto?.OvertimeFirstSeat is int s
        ? (s == MySeatNo && _view?.IsSpectator == false ? "You" : _view?.Snapshot.Seats.FirstOrDefault(x => x.Seat == s)?.Player.DisplayName)
        : null;

    private async Task NavigateToResultLater(CancellationToken ct)
    {
        try { await Task.Delay(2600, ct); } catch (TaskCanceledException) { return; }
        await InvokeAsync(GoToResult);
    }

    private void GoToResult()
    {
        _navCts?.Cancel();
        if (!IsDisposed) Nav.NavigateTo($"result/{Id}");
    }

    // ---- derived view ----
    private int MySeatNo => _view?.MySeat ?? 0;
    private SeatDto? MySeatDto => _view?.Snapshot.Seats.FirstOrDefault(s => s.Seat == MySeatNo);
    private SeatDto? OppSeatDto => _view?.Snapshot.Seats.FirstOrDefault(s => s.Seat != MySeatNo);
    private bool Ended => _view?.Result is not null || _view?.Snapshot.Phase == GamePhase.Ended;
    private bool HasClock => _view?.Snapshot.TimeControl != TimeControl.Unlimited;
    private bool IsDaily => _view?.Snapshot.TimeControl == TimeControl.Daily;
    private bool InSuddenDeath => !Ended && (_clock?.SuddenDeath ?? _view?.Snapshot.Clock?.SuddenDeath ?? false);
    private int? ToMoveSeat => _clock?.ToMoveSeat ?? _view?.Snapshot.ToMoveSeat;

    /// <summary>The faded piece: the next to vanish, only while the game runs.</summary>
    private int? Ghost => Ended ? null : _view?.Snapshot.NextToVanish;

    /// <summary>Classic engine state (null in Arena, where the server's legal cells are used).</summary>
    private GameState? EngineState => _view?.Snapshot.ArenaRules is null ? _view?.Engine : null;

    /// <summary>The waiting side's oldest piece (vanishes on their next placement; per-player cap only).</summary>
    private int? Aging => Ended ? null : BoardHints.WaitingVanish(EngineState);

    private string? _blocked;
    private int _blockedPly = -1;

    private string? BlockedText => _blocked is not null && _view?.Snapshot.Ply == _blockedPly && CanMove ? _blocked : null;

    private void Blocked(int cell)
    {
        if (!CanMove || _view is null) return;
        _blocked = BoardHints.BlockedReason(EngineState, cell) ?? "You can't play there";
        _blockedPly = _view.Snapshot.Ply;
    }

    private Color? Winner => (_view?.Result ?? _view?.Snapshot.Result)?.Outcome switch
    {
        Outcome.XWins => Color.X,
        Outcome.OWins => Color.O,
        _ => null,
    };

    /// <summary>Board input is enabled only on my turn, in the placement phase, with nothing pending.</summary>
    private bool CanMove => _view is { IsMyTurn: true, IsSpectator: false, Result: null, PendingCell: null }
                            && _view.Snapshot.Phase == GamePhase.AwaitingPlacement;

    private bool SwapOpen => _view is { IsMyTurn: true, IsSpectator: false, Result: null }
                             && _view.Snapshot.Phase == GamePhase.AwaitingSwapDecision;

    private bool IsActive(SeatDto? s) => s is not null && !Ended && ToMoveSeat == s.Seat;
    private ClockUrgency UrgencyFor(SeatDto? s) => IsActive(s) ? _clock?.Urgency ?? ClockUrgency.Normal : ClockUrgency.Idle;
    private int? ClockFor(SeatDto? s) => _clock is null ? null : IsActive(s) ? _clock.RemainingMs : _clock.AllowanceMs;

    private int? LastPlaced => _view?.Snapshot.Actions.LastOrDefault(a => a.Kind == ActionKind.Place)?.Cell;

    private string AlertClass
    {
        get
        {
            if (IsArena && !Ended)
            {
                if (ArenaDto?.Overtime == true) return "sd sd-2 arena-ot";
                if (ArenaRed) return $"sd sd-1 arena-red{(_view?.IsMyTurn == true && _clock?.Urgency == ClockUrgency.Critical ? " crit" : "")}";
                return "arena";
            }
            if (!InSuddenDeath) return "";
            var allowance = _clock?.AllowanceMs ?? 15000;
            var level = allowance >= 8000 ? 1 : allowance >= 5000 ? 2 : 3;
            var crit = _view?.IsMyTurn == true && _clock?.Urgency == ClockUrgency.Critical;
            return $"sd sd-{level}{(crit ? " crit" : "")}";
        }
    }

    private (string? Mover, string? Waiting) HintText
    {
        get
        {
            if (_view is null || Ended) return (null, null);
            var spectator = _view.IsSpectator;
            if (EngineState is { } e)
                return (BoardHints.MoverCaption(e, moverIsYou: _view.IsMyTurn), BoardHints.WaitingCaption(e, waitingIsYou: !_view.IsMyTurn && !spectator));
            if (Ghost is not int g) return (null, null);
            var c = _view.Snapshot.Board.Length > g ? _view.Snapshot.Board[g] : '.';
            if (c == '.') return (null, null);
            var mine = MySeatDto is { } me && (me.Color == Color.X ? 'X' : 'O') == c;
            var blocked = !_view.Snapshot.Rules.VacatedCellPlayable;
            if (_view.IsMyTurn && mine) return ($"Your faded {c} vanishes when you place{(blocked ? " — you can't play there this turn" : "")}", null);
            return (_view.IsMyTurn ? $"Faded {c} vanishes when you place" : $"Faded {c} vanishes on their move", null);
        }
    }

    private GameResultForUser MyResult
    {
        get
        {
            if (_view?.Summary is { } s) return s.YourResult;
            var r = _view?.Result;
            if (r is null || r.Reason == EndReason.Aborted) return GameResultForUser.Aborted;
            if (r.Outcome == Outcome.Draw || r.WinnerSeat is null) return GameResultForUser.Draw;
            return r.WinnerSeat == MySeatNo ? GameResultForUser.Win : GameResultForUser.Loss;
        }
    }

    private string ResultTitle => _view!.IsSpectator
        ? Winner is Color w ? $"{w} wins" : "Draw"
        : MyResult switch { GameResultForUser.Win => "VICTORY!", GameResultForUser.Loss => "DEFEAT", GameResultForUser.Draw => "DRAW", _ => "ABORTED" };

    private string? EmoteFor(SeatDto? s)
    {
        if (s is null || _view is null) return null;
        if (s.Seat != MySeatNo && Settings.State.MuteOpponentEmotes) return null;
        return _view.RecentEmotes.LastOrDefault(e => e.Seat == s.Seat)?.Text;
    }

    private string Announcement
    {
        get
        {
            var a = _view?.Snapshot.Actions.LastOrDefault();
            if (a is null) return "";
            if (IsArena && ArenaDto?.LastHit is { } h && h.Ply == a.Ply)
                return $"{(h.Seat == MySeatNo && !_view!.IsSpectator ? "You" : "Opponent")} shattered {h.Lines} line{(h.Lines > 1 ? "s" : "")} for {h.Damage} damage{(h.Crit ? ", critical hit" : "")}";
            var n = _view!.Snapshot.Rules.BoardSize;
            var who = a.Seat == MySeatNo && !_view.IsSpectator ? "You" : "Opponent";
            return a.Kind switch
            {
                ActionKind.Swap => $"{who} swapped sides",
                ActionKind.KeepSides => $"{who} kept sides",
                _ => $"{who} placed {a.Color} at row {a.Cell / n + 1}, column {a.Cell % n + 1}{(a.VanishedCell is int v ? $"; piece at row {v / n + 1}, column {v % n + 1} vanished" : "")}",
            };
        }
    }

    private static string ErrorText(string code) => code switch
    {
        ErrorCodes.NotYourTurn => "Not your turn",
        ErrorCodes.CellJustVacated => "That cell just emptied. Pick another.",
        ErrorCodes.Occupied => "That cell is taken",
        ErrorCodes.StalePly => "Board updated. Try again.",
        _ => "Move rejected",
    };

    // ---- intents ----
    private Task Place(int cell)
    {
        _blocked = null;
        return CanMove ? Matches.PlaceAsync(Id, cell) : Task.CompletedTask;
    }
    private Task Decide(bool swap) => Matches.DecideSwapAsync(Id, swap);
    private Task Resign() => Matches.ResignAsync(Id);
    private Task Emote(string id) => Matches.SendEmoteAsync(Id, id);
    private Task UpdateSettings(Func<SettingsState, SettingsState> f) => Settings.UpdateAsync(f);

    private void Leave()
    {
        _menu = false;
        Nav.NavigateTo("");
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Matches.ClockTick -= OnTick;
            _navCts?.Cancel();
            _navCts?.Dispose();
            if (_view is { Result: null } || _view?.IsSpectator == true) Matches.Close(Id);
        }
        base.Dispose(disposing);
    }
}
