@page "/social/messages"
@inherits StoreComponent
@inject ISessionStore Session
@inject ISocialStore Social

<PageTitle>Messages · Tic Tac Toe Ultimate</PageTitle>
<div class="t-row" style="flex-wrap:nowrap">
    <a class="t-iconbtn t-iconbtn--round" href="social" aria-label="Back"><Icon Name="back" /></a>
    <h1 class="t-heading">Messages</h1>
</div>

@if (Session.State.IsGuest)
{
    <Card><p class="t-small t-muted" style="margin:0">Messages are between mutual friends. <a href="signin?mode=login">Log in</a> or <a href="signin?mode=create">create an account</a> to chat.</p></Card>
}
else if (!Social.State.Loaded)
{
    <BertLoader Text="Opening your inbox" Mood="wave" />
}
else if (Social.State.Friends.Length == 0)
{
    <div class="t-empty"><Bert Mood="wink" Size="56" /><span>No friends yet. Add some from Social, then chat here.</span></div>
}
else
{
    <section class="t-card" style="padding:4px 16px" aria-label="Conversations">
        @foreach (var f in Threads)
        {
            <a class="t-listrow" href="@($"social/chat/{f.Player.UserId}")" style="color:inherit;text-decoration:none" data-testid="thread">
                <Avatar Name="@f.Player.DisplayName" AvatarId="@f.Player.AvatarId" Presence="f.Presence.Status" />
                <div class="who">
                    <div class="name">@f.Player.DisplayName</div>
                    <div class="meta @(f.UnreadMessages > 0 ? "unread-preview" : null)">@(Last(f) is { } lm ? Preview(lm) : PresenceDot.Text(f.Presence.Status))</div>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
                    @if (Last(f) is { } ts) { <span class="t-small t-muted">@Ago(ts.SentAt)</span> }
                    @if (f.UnreadMessages > 0) { <span class="t-chip unread" aria-label="@($"{f.UnreadMessages} unread")">@f.UnreadMessages</span> }
                </div>
            </a>
        }
    </section>
}

@code {
    private DirectMessageDto? Last(FriendDto f) =>
        Social.State.Threads.TryGetValue(f.Player.UserId, out var t) && !t.IsEmpty && (f.LastMessage is null || t[^1].Id >= f.LastMessage.Id) ? t[^1] : f.LastMessage;

    /// <summary>Most recent conversation first (like Instagram); friends you never messaged come last, alphabetically.</summary>
    private IEnumerable<FriendDto> Threads => Social.State.Friends
        .OrderByDescending(f => Last(f)?.SentAt ?? DateTimeOffset.MinValue)
        .ThenBy(f => f.Player.DisplayName, StringComparer.OrdinalIgnoreCase);

    private static string Ago(DateTimeOffset at)
    {
        var d = DateTimeOffset.UtcNow - at;
        return d.TotalMinutes < 1 ? "now" : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes}m" : d.TotalHours < 24 ? $"{(int)d.TotalHours}h" : d.TotalDays < 7 ? $"{(int)d.TotalDays}d" : at.ToString("MMM d", CultureInfo.InvariantCulture);
    }

    private string Preview(DirectMessageDto m)
    {
        var body = m.Body.StartsWith("emote:", StringComparison.Ordinal) ? "sent an emote" : m.Body;
        return (m.From == Session.State.Me?.UserId ? "You: " : "") + (body.Length > 60 ? body[..57] + "…" : body);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Session, Social);
        if (!Session.State.IsGuest && !Social.State.Loaded) { try { await Social.LoadAsync(); } catch (Exception) { } }
    }
}
