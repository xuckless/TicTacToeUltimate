@page "/profile"
@page "/u/{Username}"
@inherits StoreComponent
@inject ISessionStore Session
@inject IGameQueries Queries
@inject ISocialStore Social
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>@(_profile is null ? L.T("profile.profile_tic_tac_toe") : L.F("profile.name_tic_tac_toe", _profile.Card.DisplayName))</PageTitle>

@if (_profile is null)
{
    @if (IsSelf && Session.State.Me is { } me)
    {
        <ProfileHeader Card="SelfCard(me)" />
        @if (_loading) { <BertLoader Text="@L.T("profile.loading_profile")" /> } else { <p class="t-muted">@(me.Kind == AccountKind.Guest ? L.T("profile.guest_profiles_are_private") : L.T("profile.profile_unavailable"))</p> }
        @if (me.Kind == AccountKind.Guest) { <AccountCta /> }
    }
    else
    {
        @if (_loading) { <BertLoader Text="@L.T("profile.loading_profile")" /> } else { <p class="t-muted">@L.T("profile.player_not_found")</p> }
    }
}
else
{
    var ranked = _profile.Ratings.FirstOrDefault(r => r.Pool == RatingPools.Headline);
    <ProfileHeader Card="_profile.Card" JoinedAt="_profile.JoinedAt" />
    @if (!IsSelf && Session.State.IsGuest)
    {
        <Card><p class="t-small t-muted" style="margin:0">@((MarkupString)L.F("profile.guest_cta", Link("signin?mode=login", "accountCta.log_in"), Link("signin?mode=create", "common.create_an_account_lower")))</p></Card>
    }
    else if (!IsSelf)
    {
        @if (_profile.Presence is { Status: PresenceStatus.InGame, MatchId: Guid live })
        {
            <a class="daily-nudge" href="@($"match/{live}")" data-testid="watch-live"><Icon Name="eye" /><span>@((MarkupString)L.T("profile.playing_right_now_watch"))</span><span class="t-chip">@L.T("friendRow.watch")</span></a>
        }
        <div class="t-row">
            @switch (_profile.FriendStatus)
            {
                case FriendStatus.None: <Button Variant="primary" Small="true" OnClick="AddFriend">@L.T("profile.add_friend")</Button> break;
                case FriendStatus.RequestSent: <Button Variant="secondary" Small="true" Disabled="true">@L.T("profile.request_sent")</Button> break;
                case FriendStatus.RequestReceived: <Button Variant="primary" Small="true" Href="social">@L.T("profile.respond_to_request")</Button> break;
                case FriendStatus.Friends:
                    <Button Variant="primary" Small="true" Href="@($"social/chat/{_profile.Card.UserId}?challenge=1")">@L.T("challengeCard.challenge")</Button>
                    <Button Variant="secondary" Small="true" Href="@($"social/chat/{_profile.Card.UserId}")">@L.T("composer.message")</Button>
                    break;
            }
            @if (_profile.FriendStatus == FriendStatus.Blocked)
            {
                <Button Variant="secondary" Small="true" OnClick="Unblock">@L.T("profile.unblock")</Button>
            }
            else
            {
                <Button Variant="ghost" Small="true" OnClick="Block">@L.T("profile.block")</Button>
            }
            <Button Variant="ghost" Small="true" OnClick="() => _reporting = true" data-testid="report-player"><Icon Name="flag" /> @L.T("messageList.report")</Button>
        </div>
        <ReportSheet Open="_reporting" Kind="@ReportKinds.Profile" Target="_profile.Card.UserId" TargetName="@_profile.Card.DisplayName" OnClose="() => _reporting = false" />
    }
    <StatGrid Stats="_profile.Stats" Ratings="_profile.Ratings" />
    <TierLadder Tier="ranked?.Tier" />
    <RecentGames Games="_profile.RecentGames" ShowHistoryLink="IsSelf" />
    @if (IsSelf) { <div class="t-row"><Button Variant="secondary" Href="settings">@L.T("appShell.settings")</Button><Button Variant="ghost" Href="leaderboards">@L.T("appShell.leaderboards")</Button></div> }
}

@code {
    private bool _reporting;
    private ProfileDto? _profile;
    private bool _loading = true;

    /// <summary>Other player's username (null = me).</summary>
    [Parameter] public string? Username { get; set; }

    private static string Link(string href, string key) => $"<a href=\"{href}\">{System.Net.WebUtility.HtmlEncode(L.T(key))}</a>";

    private bool IsSelf => Username is null || string.Equals(Username, Session.State.Me?.Username ?? Session.State.Me?.DisplayName, StringComparison.OrdinalIgnoreCase);

    /// <inheritdoc />
    protected override void OnInitialized() => Subscribe(Session);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _profile = null;
        var name = Username ?? Session.State.Me?.Username;
        if (name is not null)
        {
            try { _profile = await Queries.GetProfileAsync(name); }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
        }
        _loading = false;
    }

    private static PlayerCardDto SelfCard(MeDto me) => new(me.UserId, me.DisplayName, me.AvatarId, me.Country, me.Kind,
        me.Ratings.FirstOrDefault(r => r.Pool == RatingPools.Headline)?.Tier, me.Ratings.FirstOrDefault(r => r.Pool == RatingPools.Headline)?.Rating, false);

    private async Task AddFriend()
    {
        var ack = await Social.SendRequestAsync(_profile!.Card.DisplayName);
        Toasts.Show(ack.Ok ? L.T("profile.request_sent") : Ui.ErrorToastText(ack.Error, L.T("profile.couldn_t_send_the_request")), ack.Ok ? ToastKind.Success : ToastKind.Error);
        if (ack.Ok) _profile = _profile with { FriendStatus = FriendStatus.RequestSent };
    }

    private async Task Block()
    {
        await Social.BlockAsync(_profile!.Card.UserId);
        _profile = _profile with { FriendStatus = FriendStatus.Blocked };
    }

    private async Task Unblock()
    {
        await Social.UnblockAsync(_profile!.Card.UserId);
        _profile = _profile with { FriendStatus = FriendStatus.None };
    }
}
