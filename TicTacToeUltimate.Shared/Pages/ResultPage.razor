@page "/result/{Id:guid}"
@inherits StoreComponent
@inject IMatchStore Matches
@inject ISessionStore Session
@inject IProgressStore Progress
@inject IQueueStore Queue
@inject ISocialStore Social
@inject ISettingsStore Settings
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Result · Tic Tac Toe Ultimate</PageTitle>

@if (_view?.Result is null)
{
    <div class="t-col" style="align-items:center">
        @if (_loading) { <BertLoader Text="Tallying the result" Mood="think" /> } else { <p class="t-muted">Result not available.</p> }
        <Button Href="">Home</Button>
    </div>
}
else
{
    var r = _view.Result;
    var s = _view.Summary;
    var opp = _view.Snapshot.Seats.FirstOrDefault(x => x.Seat != (_view.MySeat ?? 0));
    <div class="result-page">
        <div class="t-result @BannerClass" data-testid="result-banner">
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
                <Bert Mood="@(YourResult switch { GameResultForUser.Win => "cheer", GameResultForUser.Loss => "sad", _ => "shocked" })" Size="72" />
                <span class="t-label">@Ui.ReasonText(r.Reason, _view.IsSpectator ? null : YourResult)</span>
                <h1><BounceText Text="@Title" /></h1>
                <span class="result-sub">vs @(opp?.Player.DisplayName ?? "opponent") · @Ui.Elapsed(_view.Snapshot.Clock?.GameElapsedMsAtTurnStart ?? 0) · @_view.Snapshot.Ply moves</span>
            </div>
        </div>

        @if (!_view.IsSpectator && opp is not null)
        {
            var me = _view.Snapshot.Seats.FirstOrDefault(x => x.Seat == (_view.MySeat ?? 0));
            <div class="result-social" data-testid="result-social">
                <div class="rs-player">
                    <Avatar Name="@opp.Player.DisplayName" AvatarId="@opp.Player.AvatarId" />
                    <span class="t-small">@opp.Player.DisplayName <BotBadge Kind="opp.Player.Kind" /></span>
                    @if (EmoteFor(opp.Seat) is { } oe) { <EmoteBubble Text="@oe" /> }
                </div>
                <div class="rs-actions">
                    @if (_emotesOpen)
                    {
                        <Button Variant="secondary" Small="true" OnClick="() => _emotes = true" data-testid="result-emote"><Icon Name="emote" /> Emote</Button>
                    }
                    @if (CanAddFriend)
                    {
                        <Button Variant="primary" Small="true" OnClick="AddFriend" Disabled="_busy" data-testid="result-add-friend"><Icon Name="social" /> Add friend</Button>
                    }
                    else if (_friendSent) { <span class="t-chip">Request sent</span> }
                </div>
                <div class="rs-player">
                    <Avatar Name="@me?.Player.DisplayName" AvatarId="@me?.Player.AvatarId" />
                    <span class="t-small">You</span>
                    @if (me is not null && EmoteFor(me.Seat) is { } ye) { <EmoteBubble Text="@ye" /> }
                </div>
                <ThrownEmote Text="@_thrownText" FromBottom="_thrownFromMe" Key="_thrownKey" />
            </div>
            <EmotePicker Open="_emotes" Emotes="Session.State.Config?.Emotes" OnPick="SendEmote" OnClose="() => _emotes = false" />
        }

        @if (s?.Rating is { } rc)
        {
            <Card>
                <div class="t-spread" style="align-items:center">
                    @if (s.Tier is not null) { <TierBadge Tier="s.Tier.After" Large="true" Provisional="rc.Provisional" /> }
                    <span class="t-delta" style="position:relative" aria-label="@($"Rating {rc.Before} to {rc.After}, {Ui.Delta(rc.Delta)}")">
                        <LocalBurst Trigger="_gainBurst" Color="var(--success)" />
                        <span aria-hidden="true">@rc.Before → @_shownRating <span class="@(rc.Delta >= 0 ? "up" : "down")">@Ui.Delta(rc.Delta)</span></span>
                    </span>
                </div>
                @if (s.Tier is not null)
                {
                    <ProgressBar Value="s.Tier.After.Progress" Label="Tier progress" />
                    <div class="t-spread t-small t-muted">
                        <span>@(s.Tier.After.Tier == Tier.Master ? "Master" : $"{s.Tier.After.PointsToNext} to {Ui.NextTierName(s.Tier.After)}")</span>
                        <span>Win streak @s.WinStreak</span>
                    </div>
                }
            </Card>
        }

        @if (s?.AnalysisAvailable == true)
        {
            <Card Label="Perfect-play review">
                <div class="analysis-teaser">
                    <div class="at-board" aria-hidden="true"><MiniBoard Size="_view.Snapshot.Rules.BoardSize" Cells="@_view.Snapshot.Board" /></div>
                    <div class="at-text">
                        <span class="at-title"><Icon Name="chart" /> Perfect-play review</span>
                        <span class="t-small t-muted">See every winning and losing move.</span>
                        @if (s.YourBlunders is int b) { <span class="at-blunders">@b blunder@(b == 1 ? "" : "s") found</span> }
                        <Button Variant="primary" Small="true" OnClick="UnlockAnalysis" Disabled="_busy"><Icon Name="ad" /> Watch ad to unlock</Button>
                    </div>
                </div>
            </Card>
        }

        @if (s?.Progress is { } progress && progress.Quests.Length > 0)
        {
            <QuestCard Progress="progress" NowMs="DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()" JustCompleted="JustCompleted" />
        }

        <div class="result-actions">
            <Button Variant="primary" Block="true" OnClick="NewMatch">New @Ui.TimeControlName(_view.Snapshot.TimeControl).ToLowerInvariant() match</Button>
            @if (RematchAllowed && opp?.Player.Kind == AccountKind.Bot)
            {
                <div class="t-small t-muted" style="text-align:center">Bots don't take rematches. Start a new match for another opponent.</div>
            }
            else if (RematchAllowed)
            {
                <Button Variant="secondary" Block="true" OnClick="Rematch" Disabled="@(_view.RematchOfferedByMe || _rematchExpired)" data-testid="rematch">
                    @(_rematchExpired ? "No answer to the rematch" : _view.RematchOfferedByMe ? $"Rematch offered… {_rematchLeft}s" : _view.RematchOfferedByOpponent ? "Accept rematch" : "Rematch")
                </Button>
            }
            <Button Variant="secondary" Block="true" OnClick="Home">Home</Button>
            @if (_view.Snapshot.Rated) { <div class="t-small t-muted" style="text-align:center">No rematch in ranked games</div> }
        </div>
    </div>
    <ImpactFrame Kind="promotion" Text="PROMOTED!" Token="@($"tier-{s?.Tier?.After.Tier.ToString().ToLowerInvariant()}")" Trigger="_promoTrigger" />
}

@code {
    private MatchView? _view;
    private bool _loading = true, _busy, _completedReported, _emotes, _emotesOpen = true, _friendSent, _rematchExpired;
    private int _rematchLeft = 60;
    private string? _thrownText;
    private bool _thrownFromMe;
    private int _thrownKey;
    private long _lastThrownAt;
    private bool _emoteBaselineSet;

    private string? EmoteFor(int seat) => _view?.RecentEmotes.LastOrDefault(e => e.Seat == seat && !(seat != _view.MySeat && Settings.State.MuteOpponentEmotes))?.Text;

    /// <summary>Add friend: accounts only, not already friends / requested / blocked, never bots or guests.</summary>
    private bool CanAddFriend
    {
        get
        {
            if (_friendSent || _view is null || _view.IsSpectator || Session.State.Me is not { Kind: AccountKind.Account }) return false;
            var opp = _view.Snapshot.Seats.FirstOrDefault(x => x.Seat != (_view.MySeat ?? 0));
            if (opp is null || opp.Player.Kind != AccountKind.Account) return false;
            var id = opp.Player.UserId;
            var s = Social.State;
            return s.Friends.All(f => f.Player.UserId != id) && s.Requests.All(r => r.From.UserId != id && r.To.UserId != id) && s.Blocked.All(b => b.UserId != id);
        }
    }

    private async Task AddFriend()
    {
        var opp = _view?.Snapshot.Seats.FirstOrDefault(x => x.Seat != (_view.MySeat ?? 0));
        if (opp is null) return;
        _busy = true;
        try
        {
            var ack = await Social.SendRequestAsync(opp.Player.DisplayName, opp.Player.UserId);
            if (ack.Ok) { _friendSent = true; Toasts.Show($"Friend request sent to {opp.Player.DisplayName}", ToastKind.Success); }
            else Toasts.Show(Ui.ErrorToastText(ack.Error, "Couldn't send the request."), ToastKind.Error);
        }
        finally { _busy = false; }
    }

    private async Task SendEmote(string id)
    {
        _emotes = false;
        await Matches.SendEmoteAsync(Id, id);
        // The match actor lingers about 2 minutes after the end; after that emotes bounce and the button goes away.
        if (Matches.State.Matches.GetValueOrDefault(Id)?.LastError is ErrorCodes.MatchNotFound or ErrorCodes.MatchOver) _emotesOpen = false;
    }

    private void ThrowNewEmotes()
    {
        if (_view is null) return;
        var newest = _view.RecentEmotes.LastOrDefault();
        if (!_emoteBaselineSet) { _emoteBaselineSet = true; _lastThrownAt = newest?.ShownAtMs ?? 0; return; }
        if (newest is { } em && em.ShownAtMs > _lastThrownAt)
        {
            _lastThrownAt = em.ShownAtMs;
            if (!(em.Seat != _view.MySeat && Settings.State.MuteOpponentEmotes)) { _thrownText = em.Text; _thrownFromMe = em.Seat == _view.MySeat; _thrownKey++; }
        }
    }

    private async Task RematchCountdown()
    {
        for (_rematchLeft = 60; _rematchLeft > 0 && _view?.RematchMatchId is null; _rematchLeft--)
        {
            try { await Task.Delay(1000, _cts.Token); } catch (TaskCanceledException) { return; }
            await InvokeAsync(StateHasChanged);
        }
        if (_view?.RematchMatchId is null) { _rematchExpired = true; await InvokeAsync(StateHasChanged); }
    }
    private int _shownRating, _promoTrigger, _gainBurst;
    private CancellationTokenSource _cts = new();

    /// <summary>Match id.</summary>
    [Parameter] public Guid Id { get; set; }

    /// <summary>Rematch only when the match is not rated (and the server allows it).</summary>
    private bool RematchAllowed => _view is not null && !_view.Snapshot.Rated && !_view.IsSpectator
                                   && (_view.Summary?.RematchAllowed ?? _view.Snapshot.RematchAllowed);

    private GameResultForUser YourResult => _view?.Summary?.YourResult ?? (_view?.Result switch
    {
        null => GameResultForUser.Aborted,
        { Reason: EndReason.Aborted } => GameResultForUser.Aborted,
        { WinnerSeat: null } => GameResultForUser.Draw,
        var r when r.WinnerSeat == (_view!.MySeat ?? 0) => GameResultForUser.Win,
        _ => GameResultForUser.Loss,
    });

    private string Title => YourResult switch
    {
        GameResultForUser.Win => "VICTORY!", GameResultForUser.Loss => "DEFEAT", GameResultForUser.Draw => "DRAW", _ => "ABORTED",
    };

    private string BannerClass
    {
        get
        {
            if (YourResult is GameResultForUser.Draw or GameResultForUser.Aborted) return "draw";
            if (YourResult == GameResultForUser.Loss) return "loss";
            var me = _view!.Snapshot.Seats.FirstOrDefault(x => x.Seat == (_view.MySeat ?? 0));
            return me?.Color == Color.O ? "o" : "x";
        }
    }

    // Win quests advance by one per win, so a quest sitting exactly on its target after a win was finished by this game.
    private string[] JustCompleted => YourResult == GameResultForUser.Win
        ? (_view?.Summary?.Progress?.Quests.Where(q => q.Completed && q.Progress == q.Target).Select(q => q.QuestId).ToArray() ?? [])
        : [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Subscribe(Matches, Social, Settings);
        _view = Matches.State.Matches.GetValueOrDefault(Id);
        if (_view is null)
        {
            try { _view = await Matches.OpenAsync(Id); }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { }
        }
        _loading = false;
        StartCountUp();
    }

    /// <inheritdoc />
    protected override void OnStoresChanged()
    {
        var hadSummary = _view?.Summary is not null;
        _view = Matches.State.Matches.GetValueOrDefault(Id) ?? _view;
        if (!hadSummary && _view?.Summary is not null) StartCountUp();
        ThrowNewEmotes();
        if (_view?.RematchMatchId is Guid next)
        {
            // The new game's clock is already running: never put an interstitial in front of it.
            _completedReported = true;
            Nav.NavigateTo($"match/{next}");
        }
    }

    private void StartCountUp()
    {
        if (_view?.Summary?.Rating is not { } rc) return;
        _shownRating = rc.Before;
        if (_view.Summary.Tier?.Promoted == true && Settings.State.ImpactFrames) _promoTrigger++;
        _ = CountUp(rc.Before, rc.After, _cts.Token);
    }

    private async Task CountUp(int from, int to, CancellationToken ct)
    {
        const int steps = 20;
        for (var i = 1; i <= steps; i++)
        {
            try { await Task.Delay(40, ct); } catch (TaskCanceledException) { return; }
            _shownRating = from + (to - from) * i / steps;
            await InvokeAsync(StateHasChanged);
        }
        // Rating gain lands: localised impact frame on the number.
        if (to > from) { _gainBurst++; await InvokeAsync(StateHasChanged); }
    }

    private async Task UnlockAnalysis()
    {
        _busy = true;
        try
        {
            var r = await Progress.ClaimRewardAsync(RewardKind.Analysis, Id);
            if (r.Granted) { _completedReported = true; Nav.NavigateTo($"replay/{Id}?analysis=1"); }   // one ad is enough: the rewarded view was the break
            else Toasts.Show(Ui.RewardFailText(r, "Watch the full ad to unlock"), ToastKind.Error);
        }
        finally { _busy = false; }
    }

    private async Task NewMatch()
    {
        var tc = _view!.Snapshot.TimeControl;
        // Retired / unlisted time controls (CasualX2 challenges, legacy Ranked) fall back to the Play page.
        var listed = tc is TimeControl.Casual or TimeControl.ArenaCasual or TimeControl.ArenaRanked or TimeControl.OldSchool or TimeControl.Unlimited;
        await Leave(tc == TimeControl.Daily ? "daily" : listed ? $"play?tc={tc}" : "play");
    }

    private async Task Rematch()
    {
        await Matches.OfferRematchAsync(Id);
        var v = Matches.State.Matches.GetValueOrDefault(Id);
        if (v?.LastError == ErrorCodes.ServerUpdating) Toasts.Show(Ui.ServerUpdatingText, ToastKind.Info);
        else if (v?.LastError is { } err && !v.RematchOfferedByMe) Toasts.Show(Ui.ErrorToastText(err, "Couldn't offer a rematch."), ToastKind.Error);
        else if (v?.RematchOfferedByMe == true && v.RematchMatchId is null) _ = RematchCountdown();   // the window is 60 s (D14)
    }
    private Task Home() => Leave("");

    private async Task Leave(string href)
    {
        await ReportCompletedAsync();
        Nav.NavigateTo(href);
    }

    private async Task ReportCompletedAsync()
    {
        if (_completedReported || _view?.Result is null || _view.IsSpectator) return;
        _completedReported = true;
        if (Services.GetService(typeof(IAdCoordinator)) is IAdCoordinator ads)
        {
            try { await ads.OnGameCompletedAsync(YourResult); }
            catch (Exception ex) when (ex is InvalidOperationException or TaskCanceledException) { }
        }
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _cts.Cancel();
            _cts.Dispose();
            if (!_completedReported) _ = ReportCompletedAsync();
            Matches.Close(Id);
        }
        base.Dispose(disposing);
    }
}
