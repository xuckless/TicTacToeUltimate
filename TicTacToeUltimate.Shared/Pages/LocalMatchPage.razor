@page "/local/play"
@layout MatchLayout
@using TicTacToeUltimate.Client.Local
@implements IDisposable
@inject TicTacToeUltimate.Shared.Services.AmbienceService Ambience
@using TicTacToeUltimate.Shared.Services
@inject LocalPlaySession Local
@inject ISettingsStore Settings
@inject ISoundService Sound
@inject IHaptics Haptics
@inject NavigationManager Nav

<PageTitle>@(_g is { IsLive: true } ? L.F("localMatch.s_turn", _g.State.ToMove) + " · " : "")@L.T("localSetup.pass_play") · Tic Tac Toe Ultimate</PageTitle>

@if (_g is null)
{
    <BertLoader Text="@L.T("localArena.starting")" Splash="true" Mood="jumpy" />
}
else
{
    var g = _g;
    var clock = g.ClockView;
    var sd = g.SuddenDeath;
    <div class="match @AlertClass" data-testid="local-match">
        <ThrownEmote Text="@_thrownText" FromBottom="_thrownFromBottom" Key="_thrownKey" />
        <div class="match-header">
            <span>@L.T("localSetup.pass_play") · @Ui.TimeControlName(g.TimeControl)@(g.Options.Preset == LocalRulePreset.Legacy7 ? " · " + L.T("localMatch.legacy_7_piece") : "")@(g.Options.Pie ? " · " + L.T("localMatch.pie") : "")</span>
            <span class="t-num" data-testid="local-score" aria-label="@L.T("localMatch.session_score")">@g.NameOf(0) @g.Score[0] – @g.Score[1] @g.NameOf(1)</span>
        </div>
        <h1 class="sr-only">@L.F("localMatch.pass_and_play_vs", g.NameOf(0), g.NameOf(1))</h1>

        @PlayerRow(1, clock, sd)

        <div class="match-board">
            <div class="local-banner @(g.State.ToMove == Color.X ? "x" : "o") @(g.IsLive ? null : "ended")" role="status" data-testid="local-banner">
                @BannerText
            </div>
            @{ var guided = Settings.State.ThreatHints && g.IsLive ? BoardHints.Threats(g.State, g.State.ToMove) : default; }
            <ThreatCallout Visible="@(!guided.IsDefaultOrEmpty)" />
            <Board Size="g.State.Rules.BoardSize" Cells="@g.Board" Ghost="g.Ghost" Aging="g.WaitingGhost" WinLine="g.Result?.WinLine" Winner="g.Result?.WinnerColor"
                   Threats="@(guided.IsDefaultOrEmpty ? null : guided)" Legal="g.LegalCells" Interactive="CanPlace" LastPlaced="g.LastPlaced" SuddenDeath="sd" OnCellSelected="Place" OnBlockedSelected="Blocked" />
            <div class="match-hint" data-testid="local-hint">
                @if (_blocked is not null)
                {
                    <span class="match-hint-blocked" role="alert">@_blocked</span>
                }
                else if (g.IsLive)
                {
                    var mover = Render(BoardHints.MoverCaptionText(g.State));
                    var waiting = Render(BoardHints.WaitingCaptionText(g.State));
                    if (mover is not null) { <span>@mover</span> }
                    if (mover is not null && waiting is not null) { <br /> }
                    if (waiting is not null) { <span class="match-hint-sub">@waiting</span> }
                }
            </div>
        </div>

        @PlayerRow(0, clock, sd)

        @if (sd && g.IsLive) { <SuddenDeathBar Clock="clock" /> }
        <div class="match-actions">
            @if (g.IsLive)
            {
                @if (g.HasClock)
                {
                    <Button Variant="secondary" Small="true" OnClick="TogglePause">@(g.Paused ? L.T("resumeBanner.resume") : L.T("localMatch.pause"))</Button>
                }
                <Button Variant="ghost" Small="true" OnClick="() => _resign = true">@L.T("matchActions.resign")</Button>
            }
            <Button Variant="ghost" Small="true" OnClick="Leave">@L.T("localArena.leave")</Button>
        </div>
        <div class="sr-only" aria-live="polite">@_announce</div>
    </div>

    @if (g.Paused && g.IsLive)
    {
        <div class="match-over" role="dialog" aria-modal="true" aria-label="@L.T("localMatch.paused")">
            <div class="t-card">
                <span class="t-hero">@L.T("localMatch.paused")</span>
                <span>@L.F("localMatch.is_next", g.NameOf(g.ToMoveSeat), g.State.ToMove)</span>
                <Button OnClick="TogglePause">@L.T("resumeBanner.resume")</Button>
            </div>
        </div>
    }

    <Sheet Open="@(g.AwaitingSwap && !g.Paused)" Title="@L.F("localMatch.swap_sides", g.NameOf(g.ToMoveSeat))" Dismissible="false">
        <p>@((MarkupString)L.F("localMatch.opened_take_their", System.Net.WebUtility.HtmlEncode(g.NameOf(1 - g.ToMoveSeat)), "<span class=\"t-piece x\">X</span>", "<span class=\"t-piece o\">O</span>"))</p>
        <div class="swap-choices">
            <Button Variant="primary" OnClick="() => Decide(true)">@L.T("swapDecisionSheet.swap")</Button>
            <Button Variant="secondary" OnClick="() => Decide(false)">@L.T("swapDecisionSheet.keep")</Button>
        </div>
    </Sheet>

    <Sheet Open="_resign" Title="@L.F("localMatch.resign_as", g.NameOf(g.ToMoveSeat))" OnClose="() => _resign = false">
        <p>@L.F("localMatch.wins_this_game", g.NameOf(1 - g.ToMoveSeat))</p>
        <div class="swap-choices">
            <Button Variant="danger" OnClick="Resign">@L.T("matchActions.resign")</Button>
            <Button Variant="secondary" OnClick="() => _resign = false">@L.T("localMatch.cancel")</Button>
        </div>
    </Sheet>

    @if (g.Result is { } r && _showOverlay)
    {
        <div class="match-over" role="dialog" aria-modal="true" aria-label="@L.T("localMatch.game_over")" data-testid="local-over">
            <div class="t-card" style="align-items:center;text-align:center">
                <Bert Mood="@(r.WinnerSeat is null ? "think" : "cheer")" Size="64" />
                <span class="t-hero"><BounceText Text="@(r.WinnerSeat is int w ? L.F("localMatch.wins_excl", g.NameOf(w)) : L.T("match.draw"))" /></span>
                <Scoreboard Name0="@g.NameOf(0)" Name1="@g.NameOf(1)" Score0="g.Score[0]" Score1="g.Score[1]" Color0="g.ColorOf(0)" Color1="g.ColorOf(1)"
                            Winner="r.WinnerSeat" Reason="@ReasonText(r)" Draws="g.Draws" />
                <Button OnClick="Rematch" data-testid="local-rematch">@L.T("localArena.rematch_swap_colours")</Button>
                <Button Variant="secondary" OnClick="() => _showOverlay = false">@L.T("localArena.view_board")</Button>
                <Button Variant="ghost" Href="local">@L.T("localArena.new_setup")</Button>
            </div>
        </div>
    }
    else if (g.Result is not null)
    {
        <div class="match-actions"><Button OnClick="Rematch">@L.T("localArena.rematch_swap_colours")</Button></div>
    }

    <ImpactFrame Kind="@_impactKind" Text="@_impactText" Token="@_impactToken" Trigger="_impactTrigger" />
    <Confetti Trigger="_confetti" />
    <EmotePicker Open="@(_emoteSeat is not null)" OnPick="ThrowEmote" OnClose="() => _emoteSeat = null" />
}

@code {
    private int? _emoteSeat;
    private int _confetti;
    private string? _thrownText;
    private bool _thrownFromBottom;
    private int _thrownKey;

    // Pass & Play: seat 0 sits at the bottom, seat 1 at the top; an emote flies at the other player.
    private void ThrowEmote(string id)
    {
        if (_emoteSeat is not int seat) return;
        _thrownText = EmoteCatalog.All.FirstOrDefault(e => e.Id == id) is { } emote ? Ui.EmoteText(emote) : id;
        _thrownFromBottom = seat == 0;
        _thrownKey++;
    }

    private LocalGameController? _g;
    private bool _resign, _showOverlay;
    private string _announce = "";
    private string? _blocked;
    private int _impactTrigger, _lastWarnSecond;
    private string _impactKind = "win", _impactText = "", _impactToken = "alert-fill";
    private CancellationTokenSource? _cts;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _g = Local.Current;
        if (_g is null) { Nav.NavigateTo("local", replace: true); return; }
        _g.Event += OnEvent;
        if (_g.State.Ply == 0 && _g.IsLive) Impact("start", L.T("match.go"), "primary-fill");
        _g.Changed += OnChanged;
        _showOverlay = _g.Result is not null;
        if (_g.HasClock)
        {
            _cts = new CancellationTokenSource();
            _ = TickLoop(_cts.Token);
        }
    }

    private RenderFragment PlayerRow(int seat, ClockView? clock, bool sd) => __builder =>
    {
        var g = _g!;
        var piece = g.ColorOf(seat);
        var active = g.IsLive && g.ToMoveSeat == seat;
        var cls = !active ? null : sd ? "active-sd" : piece == Color.X ? "active-x" : "active-o";
        <div class="t-player @cls" aria-label="@($"{g.NameOf(seat)}, {piece}")" data-testid="@($"local-seat-{seat}")">
            <Avatar Name="@g.NameOf(seat)" />
            <div class="who">
                <div class="name">@g.NameOf(seat) <PieceGlyph Color="piece" /></div>
                <div class="meta @(active ? (sd ? "sd" : "yourmove") : null)">@(active ? (sd && clock?.AllowanceMs is int a ? L.F("playerCard.your_move_window", Ui.Seconds(a)) : L.T("activeGames.your_move")) : L.P("localMatch.won", g.Score[seat]))</div>
            </div>
            @if (g.HasClock)
            {
                <PlayerClock RemainingMs="@(active ? clock?.RemainingMs : clock?.AllowanceMs)" Piece="piece" Active="active" SuddenDeath="sd"
                             Urgency="@(active ? g.Urgency : ClockUrgency.Idle)" />
            }
            <button type="button" class="t-iconbtn t-iconbtn--round seat-emote" aria-label="@L.F("localMatch.emote_from", g.NameOf(seat))" @onclick="() => _emoteSeat = seat"><Icon Name="emote" /></button>
        </div>
    };

    private bool CanPlace => _g is { IsLive: true, Paused: false } g && g.State.Phase == GamePhase.AwaitingPlacement;

    private string BannerText
    {
        get
        {
            var g = _g!;
            if (g.Result is { } r) return r.WinnerSeat is int w ? L.F("match.wins", g.NameOf(w)) : L.T("match.draw");
            var who = g.NameOf(g.ToMoveSeat);
            if (g.AwaitingSwap) return L.F("localMatch.decides_swap_or_keep", who);
            return L.F("localMatch.s_turn_pass_the_device", g.State.ToMove, who);
        }
    }

    private string AlertClass
    {
        get
        {
            if (_g is not { IsLive: true, SuddenDeath: true } g) return "";
            var allowance = g.Allowance?.TotalMilliseconds ?? 15000;
            var level = allowance >= 8000 ? 1 : allowance >= 5000 ? 2 : 3;
            return $"sd sd-{level}{(g.Urgency == ClockUrgency.Critical ? " crit" : "")}";
        }
    }

    private static string ReasonText(LocalGameResult r) => r.Reason switch
    {
        LocalEndReason.Line => L.T("localMatch.three_in_a_row"),
        LocalEndReason.Timeout => L.T("localMatch.out_of_time"),
        LocalEndReason.Resign => L.T("localMatch.resigned"),
        _ => L.T("localMatch.no_legal_moves"),
    };

    private async Task TickLoop(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(() =>
                {
                    if (_g is null) return;
                    _g.Tick();
                    WarnTick();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private void WarnTick()
    {
        if (_g is not { IsLive: true, Paused: false, Remaining: { } rem }) { _lastWarnSecond = 0; return; }
        var ms = (int)rem.TotalMilliseconds;
        if (ms is <= 0 or > 5000) { _lastWarnSecond = 0; return; }
        var sec = (ms + 999) / 1000;
        if (sec == _lastWarnSecond) return;
        _lastWarnSecond = sec;
        Sfx(sec == 5 ? SoundCue.Warning : SoundCue.Tick);
        Haptic(sec == 5 ? HapticCue.Warning : HapticCue.Tick);
    }

    private void OnChanged()
    {
        if (_g is { } g) Ambience.Set(AmbienceMode.Match, g.SuddenDeath, g.Urgency, AlertClass);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnEvent(LocalGameEvent e)
    {
        var g = _g!;
        switch (e.Kind)
        {
            case LocalEventKind.Placed:
                Sfx(e.Color == Color.X ? SoundCue.PlaceX : SoundCue.PlaceO);
                Haptic(HapticCue.Place);
                if (e.VanishedCell is not null) { Sfx(SoundCue.Vanish); Haptic(HapticCue.Vanish); }
                var n = g.State.Rules.BoardSize;
                _announce = L.F("match.placed_at_row", g.NameOf(e.Seat), e.Color, e.Cell / n + 1, e.Cell % n + 1);
                break;
            case LocalEventKind.Swapped:
                _announce = L.F("match.swapped_sides", g.NameOf(e.Seat));
                break;
            case LocalEventKind.KeptSides:
                _announce = L.F("match.kept_sides", g.NameOf(e.Seat));
                break;
            case LocalEventKind.AutoMoved:
                Sfx(SoundCue.Warning);
                _announce = L.F("localMatch.ran_out_of_time", g.NameOf(e.Seat));
                break;
            case LocalEventKind.SuddenDeath:
                Sfx(SoundCue.SuddenDeath);
                Impact("suddendeath", L.T("matchHeader.sudden_death"), "alert-fill");
                break;
            case LocalEventKind.Ended:
                var r = g.Result!;
                _resign = false;
                if (r.WinnerSeat is int w)
                {
                    Sfx(SoundCue.Win); Haptic(HapticCue.Win);
                    _confetti++;
                    _ = RevealOverlayLater(Settings.State.ImpactFrames ? 1400 : 0);
                    Impact("win", L.F("localMatch.name_wins_caps", g.NameOf(w).ToUpperInvariant()), r.WinnerColor == Color.O ? "piece-o" : "piece-x");
                    _announce = L.F("localMatch.wins_reason", g.NameOf(w), ReasonText(r));
                }
                else { _announce = L.T("match.draw"); _showOverlay = true; }
                break;
        }
    }

    private async Task RevealOverlayLater(int ms)
    {
        if (ms > 0) await Task.Delay(ms);
        _showOverlay = true;
        await InvokeAsync(StateHasChanged);
    }

    private void Impact(string kind, string text, string token)
    {
        if (!Settings.State.ImpactFrames) return;
        _impactKind = kind; _impactText = text; _impactToken = token;
        _impactTrigger++;
    }

    private void Sfx(SoundCue cue)
    {
        if (!Settings.State.Sfx) return;
        try { Sound.Play(cue); } catch (Exception) { /* audio optional */ }
    }

    private void Haptic(HapticCue cue)
    {
        if (!Settings.State.Haptics) return;
        try { Haptics.Play(cue); } catch (Exception) { /* haptics optional */ }
    }

    // ---- intents ----
    private void Place(int cell)
    {
        if (!CanPlace) return;
        _blocked = null;
        if (_g!.Place(cell) != MoveError.None) { Blocked(cell); }
    }

    private void Blocked(int cell)
    {
        if (!CanPlace) return;
        _blocked = Render(BoardHints.BlockedReasonText(_g!.State, cell));
        _announce = _blocked ?? _announce;
        Sfx(SoundCue.Error); Haptic(HapticCue.Error);
    }

    private static string? Render(LocalizedHint? h) => h is null ? null : L.F(h.Key, h.Args);

    private void Decide(bool swap) => _g?.DecideSwap(swap);

    private void Resign()
    {
        _resign = false;
        _g?.Resign();
    }

    private void TogglePause()
    {
        if (_g is null) return;
        if (_g.Paused) _g.Resume(); else _g.Pause();
    }

    private void Rematch()
    {
        _showOverlay = false;
        _g?.Rematch();
    }

    private void Leave()
    {
        _g?.Pause();
        Nav.NavigateTo("local");   // Home sits behind the sign-in gate; Pass & Play setup works offline
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (_g is not null)
        {
            _g.Event -= OnEvent;
            _g.Changed -= OnChanged;
            _g.Pause();   // leaving the board never burns anyone's clock
        }
    }
}
