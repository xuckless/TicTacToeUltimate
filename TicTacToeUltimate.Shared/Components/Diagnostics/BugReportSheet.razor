@using TicTacToeUltimate.Client.Diagnostics
@inject CrashReporter Reporter
@inject ToastService Toasts

@* "Report a bug" (owner decision 2026-10-16): a description, optionally the screenshot taken just before this sheet opened. *@
<Sheet Open="Open" Title="Report a bug" OnClose="Close">
    <div class="t-col" style="padding:0;gap:12px">
        <div class="t-field">
            <label class="t-label" for="bug-text">What went wrong?</label>
            <textarea id="bug-text" class="t-input" rows="5" maxlength="4000" placeholder="What you did, what you expected, what happened instead" @bind="_text" @bind:event="oninput"></textarea>
        </div>
        @if (Screenshot is not null)
        {
            <label class="t-toggle"><span>Include a screenshot of the screen</span><input type="checkbox" @bind="_withShot" /></label>
            @if (_withShot) { <img class="bug-shot" src="@($"data:image/png;base64,{Screenshot}")" alt="Screenshot that will be attached" /> }
        }
        @if (Reporter.LastCrash is not null)
        {
            <label class="t-toggle"><span>Include details of the last error</span><input type="checkbox" @bind="_withCrash" /></label>
        }
        <p class="t-small t-muted" style="margin:0">We also send your app version, device, recent screens and taps (never your messages).</p>
        <Button Variant="primary" Block="true" OnClick="Send" Disabled="@(_busy || string.IsNullOrWhiteSpace(_text))" data-testid="bug-send">Send report</Button>
    </div>
</Sheet>

@code {
    private string _text = "";
    private bool _withShot = true, _withCrash = true, _busy;

    /// <summary>Visible.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>Screenshot taken before opening (base64 PNG), if any.</summary>
    [Parameter] public string? Screenshot { get; set; }
    /// <summary>Close requested.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Send()
    {
        _busy = true;
        var ok = await Reporter.ReportBugAsync(_text.Trim(), _withShot ? Screenshot : null, _withCrash);
        _busy = false;
        if (ok) { Toasts.Show("Thanks! Your report was sent.", ToastKind.Success); _text = ""; await OnClose.InvokeAsync(); }
        else Toasts.Show("Couldn't send the report. Check your connection and try again.", ToastKind.Error);
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
