<div class="t-listrow">
    <Avatar Name="@Other.DisplayName" AvatarId="@Other.AvatarId" />
    <div class="who"><div class="name">@Other.DisplayName</div><div class="meta">@(Request.Direction == FriendRequestDirection.Incoming ? L.T("friendRequestRow.wants_to_be_friends") : L.T("profile.request_sent"))</div></div>
    @if (Request.Direction == FriendRequestDirection.Incoming)
    {
        <Button Variant="primary" Small="true" OnClick="() => OnRespond.InvokeAsync((Request, true))">@L.T("challengeCard.accept")</Button>
        <IconButton Label="@L.T("challengeCard.decline")" Icon="close" Round="true" OnClick="() => OnRespond.InvokeAsync((Request, false))" />
    }
</div>

@code {
    /// <summary>Request.</summary>
    [Parameter, EditorRequired] public FriendRequestDto Request { get; set; } = default!;
    /// <summary>Accept/decline.</summary>
    [Parameter] public EventCallback<(FriendRequestDto Request, bool Accept)> OnRespond { get; set; }

    private PlayerCardDto Other => Request.Direction == FriendRequestDirection.Incoming ? Request.From : Request.To;
}
