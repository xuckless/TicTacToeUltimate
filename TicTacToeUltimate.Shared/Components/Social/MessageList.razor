<div class="chat" role="log" aria-live="polite" aria-label="Messages">
    @if (Messages.Count == 0)
    {
        <p class="t-muted t-small">No messages yet. Say hi!</p>
    }
    @foreach (var m in Messages)
    {
        @if (EmoteOf(m.Body) is { } e)
        {
            <div class="msg emote @(m.From == MeId ? "mine" : null)" aria-label="@($"Emote: {e.Text}")">
                @if (e.Text.StartsWith("bert:", StringComparison.Ordinal)) { <Bert Mood="@e.Text[5..]" Size="96" Bob="false" /> }
                else { <span class="thrown-phrase">@e.Text</span> }
            </div>
        }
        else
        {
            <div class="msg @(m.From == MeId ? "mine" : null)">@m.Body
                @if (OnReport.HasDelegate && m.From != MeId)
                {
                    <button type="button" class="msg-report" aria-label="Report this message" title="Report" @onclick="() => OnReport.InvokeAsync(m)"><Icon Name="flag" /></button>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>Messages oldest first.</summary>
    [Parameter] public IReadOnlyList<DirectMessageDto> Messages { get; set; } = [];
    /// <summary>Local user id.</summary>
    [Parameter] public Guid MeId { get; set; }
    /// <summary>Report a received message (shows a flag button on each one).</summary>
    [Parameter] public EventCallback<DirectMessageDto> OnReport { get; set; }

    private static EmoteDto? EmoteOf(string body) =>
        body.StartsWith("emote:", StringComparison.Ordinal) ? EmoteCatalog.All.FirstOrDefault(e => e.Id == body["emote:".Length..]) : null;
}
