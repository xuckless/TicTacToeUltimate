<section class="t-card" style="padding:4px 16px" aria-label="@L.T("challengeCard.challenge")">
    <div class="t-listrow">
        <Avatar Name="@Challenge.From.DisplayName" AvatarId="@Challenge.From.AvatarId" />
        <div class="who"><div class="name">@Challenge.From.DisplayName</div><div class="meta">@L.F("challengeCard.challenges_you", Ui.TimeControlName(Challenge.TimeControl))</div></div>
        <Button Variant="primary" Small="true" OnClick="() => OnAccept.InvokeAsync(Challenge)">@L.T("challengeCard.accept")</Button>
        @if (OnDecline.HasDelegate)
        {
            <IconButton Label="@L.T("challengeCard.decline")" Icon="close" Round="true" OnClick="() => OnDecline.InvokeAsync(Challenge)" />
        }
    </div>
</section>

@code {
    /// <summary>Challenge.</summary>
    [Parameter, EditorRequired] public ChallengeDto Challenge { get; set; } = default!;
    /// <summary>Accept.</summary>
    [Parameter] public EventCallback<ChallengeDto> OnAccept { get; set; }
    /// <summary>Decline.</summary>
    [Parameter] public EventCallback<ChallengeDto> OnDecline { get; set; }
}
