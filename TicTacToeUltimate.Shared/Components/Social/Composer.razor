@inject ISessionStore Session

<div class="composer">
    <IconButton Label="@L.T("emotePicker.emotes")" Icon="emote" OnClick="() => _emotes = true" Disabled="_busy" />
    <div style="flex:1"><TextField Label="@L.T("composer.message")" HideLabel="true" Placeholder="@L.T("composer.message")" Value="@_text" ValueChanged="v => _text = v" OnEnter="Send" MaxLength="500" /></div>
    <IconButton Label="@L.T("composer.send")" Icon="send" OnClick="Send" Disabled="@(string.IsNullOrWhiteSpace(_text) || _busy)" />
</div>
<EmotePicker Open="_emotes" Emotes="Session.State.Config?.Emotes" OnPick="SendEmote" OnClose="() => _emotes = false" />

@code {
    private string _text = "";
    private bool _busy, _emotes;

    /// <summary>Send; return false to keep the text.</summary>
    [Parameter] public Func<string, Task<bool>> OnSend { get; set; } = _ => Task.FromResult(true);

    private async Task Send()
    {
        var t = _text.Trim();
        if (t.Length == 0 || _busy) return;
        _busy = true;
        try { if (await OnSend(t)) _text = ""; }
        finally { _busy = false; }
    }

    /// <summary>Game emotes travel as "emote:&lt;id&gt;" messages (the server checks the id).</summary>
    private async Task SendEmote(string id)
    {
        _emotes = false;
        if (_busy) return;
        _busy = true;
        try { await OnSend("emote:" + id); }
        finally { _busy = false; }
    }
}
