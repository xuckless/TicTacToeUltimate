<Card>
    <div class="t-spread"><span class="t-label">@L.T("tierLadder.tier_progress")</span>
        @if (Tier is not null && Tier.Tier != Contracts.Tier.Master) { <span class="t-small t-muted">@L.F("tierLadder.points_to_next", Tier.PointsToNext, Ui.NextTierName(Tier))</span> }
    </div>
    <div class="tier-ladder" role="img" aria-label="@L.F("tierLadder.tier", Ui.TierName(Tier))">
        @foreach (var t in Enum.GetValues<Contracts.Tier>())
        {
            <span style="@(Tier is not null && t <= Tier.Tier ? $"background:var(--tier-{t.ToString().ToLowerInvariant()})" : null)"></span>
        }
    </div>
    <div class="tier-ladder-labels"><span>@L.T("tierLadder.brz")</span><span>@L.T("tierLadder.slv")</span><span>@L.T("tierLadder.gld")</span><span>@L.T("tierLadder.plt")</span><span>@L.T("tierLadder.dia")</span><span>@L.T("tierLadder.mst")</span></div>
</Card>

@code {
    /// <summary>Current tier.</summary>
    [Parameter] public TierDto? Tier { get; set; }
}
