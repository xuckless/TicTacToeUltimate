<section class="t-col" style="padding:0;gap:0">
    <div class="t-spread" style="padding-bottom:4px"><h2 class="t-heading">@L.T("recentGames.recent_games")</h2>@if (ShowHistoryLink) { <a href="history" class="t-small">@L.T("appShell.history")</a> }</div>
    @if (Games.Count == 0)
    {
        <div class="t-empty"><Bert Mood="happy" Size="52" /><span>@L.T("recentGames.no_games_yet_your_first")</span></div>
    }
    @foreach (var g in Games)
    {
        <GameRow Game="g" />
    }
</section>

@code {
    /// <summary>Games newest first.</summary>
    [Parameter] public IReadOnlyList<GameSummaryDto> Games { get; set; } = [];
    /// <summary>Link to /history.</summary>
    [Parameter] public bool ShowHistoryLink { get; set; } = true;
}
