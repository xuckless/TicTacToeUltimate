@* Round clock, red-alert ×2 phase and the overtime "next line wins" banner. *@
@if (Overtime)
{
    <div class="arena-banner ot" role="status" data-testid="arena-overtime">
        <span class="t-label">@L.T("arenaBanner.overtime")</span>
        <span class="big"><BounceText Text="@L.T("arenaBanner.next_line_wins")" Class="wiggle" /></span>
        @if (FirstMover is not null) { <span class="sub">@(FirstMover == L.T("result.you") ? L.T("arenaBanner.you_move_first") : L.F("arenaBanner.moves_first", FirstMover))</span> }
    </div>
}
else
{
    <div class="arena-banner @(RedAlert ? "red" : null)" role="timer" aria-label="@L.F("arenaBanner.round_left", Ui.Elapsed(RemainingMs))" data-testid="arena-round">
        <span class="t-label">@(RedAlert ? L.T("arenaBanner.red_alert") : L.T("arenaBanner.round"))</span>
        <span class="t-num big">@Ui.Elapsed(RemainingMs)</span>
        @if (RedAlert) { <span class="x2" aria-label="@L.T("arenaBanner.double_damage")">@L.F("arenaBanner.dmg", Multiplier)</span> }
        else if (Multiplier > 1) { <span class="sub">@L.F("arenaBanner.damage_in_the_last", Multiplier, Ui.Seconds(RedAlertMs))</span> }
    </div>
}

@code {
    /// <summary>Round time left (ms).</summary>
    [Parameter] public int RemainingMs { get; set; }
    /// <summary>In the red-alert window.</summary>
    [Parameter] public bool RedAlert { get; set; }
    /// <summary>Red-alert damage multiplier.</summary>
    [Parameter] public int Multiplier { get; set; } = 2;
    /// <summary>Red-alert window length (ms).</summary>
    [Parameter] public int RedAlertMs { get; set; } = 30_000;
    /// <summary>Sudden-death overtime.</summary>
    [Parameter] public bool Overtime { get; set; }
    /// <summary>Name of who moves first in overtime (L.T("result.you") = "You", or "Rook").</summary>
    [Parameter] public string? FirstMover { get; set; }
}
