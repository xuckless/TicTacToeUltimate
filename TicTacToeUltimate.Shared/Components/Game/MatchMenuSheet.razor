<Sheet Open="Open" Title="@L.T("matchMenuSheet.match")" OnClose="OnClose">
    <label class="t-toggle"><span>@L.T("matchMenuSheet.sound_effects")</span><input type="checkbox" checked="@Settings.Sfx" @onchange="e => Update(s => s with { Sfx = (bool)e.Value! })" /></label>
    <label class="t-toggle"><span>@L.T("matchMenuSheet.haptics")</span><input type="checkbox" checked="@Settings.Haptics" @onchange="e => Update(s => s with { Haptics = (bool)e.Value! })" /></label>
    <label class="t-toggle"><span>@L.T("matchMenuSheet.impact_frames")</span><input type="checkbox" checked="@Settings.ImpactFrames" @onchange="e => Update(s => s with { ImpactFrames = (bool)e.Value! })" /></label>
    <label class="t-toggle"><span>@L.T("matchMenuSheet.mute_opponent_emotes")</span><input type="checkbox" checked="@Settings.MuteOpponentEmotes" @onchange="e => Update(s => s with { MuteOpponentEmotes = (bool)e.Value! })" /></label>
    <Button Variant="secondary" Block="true" OnClick="OnLeave">@(Ended || Spectator ? L.T("localArena.leave") : L.T("matchMenuSheet.back_to_home_game"))</Button>
</Sheet>

@code {
    /// <summary>Visible.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>Current settings.</summary>
    [Parameter, EditorRequired] public SettingsState Settings { get; set; } = SettingsState.Default;
    /// <summary>Settings change.</summary>
    [Parameter] public EventCallback<Func<SettingsState, SettingsState>> OnSettings { get; set; }
    /// <summary>Leave the match screen.</summary>
    [Parameter] public EventCallback OnLeave { get; set; }
    /// <summary>Close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Game over.</summary>
    [Parameter] public bool Ended { get; set; }
    /// <summary>Spectating.</summary>
    [Parameter] public bool Spectator { get; set; }

    private Task Update(Func<SettingsState, SettingsState> f) => OnSettings.InvokeAsync(f);
}
