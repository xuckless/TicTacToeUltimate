@* One emote bubble: a Bert mood or a phrase. *@
@if (Text is not null)
{
    @if (Text.StartsWith("bert:", StringComparison.Ordinal))
    {
        <span class="emote-bubble bert-bubble" role="status" aria-label="@($"Bert {Text[5..]}")"><Bert Mood="@Text[5..]" Size="56" /></span>
    }
    else
    {
        <span class="emote-bubble" role="status">@Text</span>
    }
}

@code {
    /// <summary>Emote text ("bert:laugh" or a phrase).</summary>
    [Parameter] public string? Text { get; set; }
}
