@if (Text is not null)
{
    <div class="conn-banner @(Phase == ConnectionPhase.Offline ? "offline" : null)" role="status">@Text</div>
}

@code {
    /// <summary>Connection phase.</summary>
    [Parameter] public ConnectionPhase Phase { get; set; }
    /// <summary>Reconnect attempt.</summary>
    [Parameter] public int Attempt { get; set; }
    /// <summary>Match resync in progress.</summary>
    [Parameter] public bool Resyncing { get; set; }

    private string? Text => Phase switch
    {
        ConnectionPhase.Reconnecting => Attempt > 1 ? L.F("connectionBanner.reconnecting_attempt", Attempt) : L.T("connectionBanner.reconnecting"),
        ConnectionPhase.Offline => L.T("connectionBanner.youre_offline_well_reconnect"),
        ConnectionPhase.Connecting => L.T("connectionBanner.connecting"),
        _ => Resyncing ? L.T("connectionBanner.syncing_game") : null,
    };
}
