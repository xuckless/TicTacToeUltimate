<div class="match-header">
    @if (Clock?.SuddenDeath == true)
    {
        <Chip Alert="true">@L.T("matchHeader.sudden_death")</Chip>
    }
    else
    {
        <span class="t-label">@Ui.ModeLabel(Mode, TimeControl)</span>
    }
    <span class="clockinfo">@Info</span>
</div>

@code {
    /// <summary>Mode.</summary>
    [Parameter] public MatchMode Mode { get; set; }
    /// <summary>Time control.</summary>
    [Parameter] public TimeControl TimeControl { get; set; }
    /// <summary>Live clock view.</summary>
    [Parameter] public ClockView? Clock { get; set; }
    /// <summary>Spectator count.</summary>
    [Parameter] public int Spectators { get; set; }

    /// <summary>"Game 0:41 · move 15s" or "Game 1:31 · window 8s → 7s in 5s".</summary>
    public string Info => InfoText(TimeControl, Clock, Spectators);

    /// <summary>Same text for the phone layout, where it sits inside the opponent's card.</summary>
    public static string InfoText(TimeControl TimeControl, ClockView? Clock, int Spectators)
    {
        {
            var spect = Spectators > 0 ? " · " + L.F("matchHeader.watching", Spectators) : "";
            if (Clock is null || Clock.AllowanceMs is null)
                return TimeControl == TimeControl.Unlimited ? L.T("matchHeader.no_clock") + spect : spect.TrimStart(' ', '·');
            var game = L.F("matchHeader.game_elapsed", Ui.Elapsed(Clock.GameElapsedMs));
            if (TimeControl == TimeControl.Daily) return game + spect;
            var now = Ui.Seconds(Clock.AllowanceMs.Value);
            if (Clock.SuddenDeath && Clock.NextAllowanceMs is int next && Clock.NextStepInMs is int inMs && next != Clock.AllowanceMs)
                return L.F("matchHeader.window_step", game, now, Ui.Seconds(next), Math.Max(0, (int)Math.Ceiling(inMs / 1000.0))) + spect;
            return Clock.SuddenDeath ? L.F("matchHeader.window", game, now) + spect : L.F("matchHeader.move", game, now) + spect;
        }
    }
}
