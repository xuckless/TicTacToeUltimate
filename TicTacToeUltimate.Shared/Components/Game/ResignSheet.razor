<Sheet Open="Open" Title="@L.T("resignSheet.resign")" OnClose="OnClose">
    <p class="t-muted">@(Rated ? L.T("resignSheet.you_will_lose_rating") : L.T("resignSheet.the_game_ends_as"))</p>
    <Button Variant="danger" Block="true" OnClick="Confirm">@L.T("matchActions.resign")</Button>
    <Button Variant="secondary" Block="true" OnClick="OnClose">@L.T("resignSheet.keep_playing")</Button>
</Sheet>

@code {
    /// <summary>Visible.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>Rated game.</summary>
    [Parameter] public bool Rated { get; set; }
    /// <summary>Confirmed.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    /// <summary>Close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Confirm() { await OnClose.InvokeAsync(); await OnConfirm.InvokeAsync(); }
}
