<Sheet Open="Open" Title="@L.T("swapDecisionSheet.swap_sides")" Dismissible="false">
    <p>@((MarkupString)L.F("swapDecisionSheet.your_opponent_opened_take", "<span class=\"t-piece x\">X</span>", "<span class=\"t-piece o\">O</span>"))</p>
    <div class="swap-choices">
        <Button Variant="primary" OnClick="() => OnDecide.InvokeAsync(true)">@L.T("swapDecisionSheet.swap")</Button>
        <Button Variant="secondary" OnClick="() => OnDecide.InvokeAsync(false)">@L.T("swapDecisionSheet.keep")</Button>
    </div>
</Sheet>

@code {
    /// <summary>Visible.</summary>
    [Parameter] public bool Open { get; set; }
    /// <summary>true = swap.</summary>
    [Parameter] public EventCallback<bool> OnDecide { get; set; }
}
