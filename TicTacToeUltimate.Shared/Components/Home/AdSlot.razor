@inject IServiceProvider Services

@if (Visible)
{
    @if (Services.GetService(typeof(IBannerAds)) is IBannerAds { BannerSlot: not null })
    {
        <div class="ad-slot real" role="complementary" aria-label="Advertisement" @ref="_host"></div>
    }
    else if (Services.GetService(typeof(IBannerAds)) is null)
    {
        @* Stub placeholder (dev / stub ads). Real ads without a banner unit render nothing. *@
        <div class="ad-slot" role="complementary" aria-label="Advertisement">Banner ad · 320×50</div>
    }
}

@code {
    private ElementReference _host;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Visible && Services.GetService(typeof(IBannerAds)) is IBannerAds { BannerSlot: not null } banner)
            await banner.RenderBannerAsync(_host);
    }

    /// <summary>Cascaded false by <see cref="Layout.MatchLayout"/>: no ads during a match.</summary>
    [CascadingParameter(Name = "AdsAllowed")] public bool? AdsAllowed { get; set; }

    /// <summary>True when the banner renders.</summary>
    public bool Visible
    {
        get
        {
            if (AdsAllowed == false) return false;
            var ads = Services.GetService(typeof(IAdCoordinator)) as IAdCoordinator;
            return ads?.BannersAllowed ?? true;
        }
    }
}
