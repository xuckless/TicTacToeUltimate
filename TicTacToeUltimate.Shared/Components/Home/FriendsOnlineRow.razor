<Card Title="@L.T("friendsOnlineRow.friends_online")">
    <Aside><a href="social" class="t-small">@L.T("friendsOnlineRow.see_all")</a></Aside>
    <ChildContent>
        @if (Online.Count == 0)
        {
            <div class="t-empty"><Bert Mood="sleepy" Size="44" /><span>@L.T("friendsOnlineRow.no_friends_online_right_now")</span></div>
        }
        else
        {
            <div class="friends-row">
                @foreach (var f in Online)
                {
                    <a href="@($"u/{f.Player.DisplayName}")" aria-label="@($"{f.Player.DisplayName}, {PresenceDot.Text(f.Presence.Status)}")">
                        <Avatar Name="@f.Player.DisplayName" AvatarId="@f.Player.AvatarId" Size="md" Presence="f.Presence.Status" />
                        @f.Player.DisplayName
                    </a>
                }
            </div>
        }
    </ChildContent>
</Card>

@code {
    /// <summary>All friends; only Online and InGame are shown.</summary>
    [Parameter] public IReadOnlyList<FriendDto> Friends { get; set; } = [];

    private List<FriendDto> Online => Friends.Where(f => f.Presence.Status != PresenceStatus.Offline).ToList();
}
