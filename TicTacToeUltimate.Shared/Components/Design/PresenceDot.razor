<span class="t-dot @Css" aria-hidden="true"></span>

@code {
    /// <summary>Status.</summary>
    [Parameter] public PresenceStatus Status { get; set; }
    private string? Css => Status switch { PresenceStatus.Online => "online", PresenceStatus.InGame => "ingame", _ => null };

    /// <summary>Copy for a status.</summary>
    public static string Text(PresenceStatus s) => s switch { PresenceStatus.Online => L.T("presenceDot.online"), PresenceStatus.InGame => L.T("presenceDot.in_a_game"), _ => L.T("presenceDot.offline") };
}
