@* Bert, the mascot: a purple ghost-blob, the "vanishing piece" come to life. A faded dashed O halo floats above
   his head (the ghost of a vanished piece). Mood changes eyes, mouth, props and animation. Bert doubles as the
   in-game emote set (EmoteCatalog ids "bert-<mood>"). Decorative unless Label is set. *@
<svg class="bert mood-@Mood @(Bob ? "bob" : null) @Class" viewBox="-10 -6 140 140" width="@Size" height="@Size"
     role="@(Label is null ? "presentation" : "img")" aria-label="@Label" aria-hidden="@(Label is null ? "true" : null)">
    <circle class="g-halo" cx="60" cy="14" r="10" />
    <g class="g-body-wrap">
        <path class="g-shadow" d="@BodyPath" transform="translate(0 6)" />
        <path class="g-body" d="@BodyPath" />
        <ellipse class="g-shine" cx="42" cy="44" rx="10" ry="6" transform="rotate(-30 42 44)" />
        @switch (Mood)
        {
            case "sleepy":
                <path class="g-line" d="M38 64q7 5 14 0M68 64q7 5 14 0" />
                <path class="g-line" d="M54 84q6-3 12 0" />
                <path class="g-z" d="M88 26h9l-9 10h9M101 14h6l-6 7h6" />
                break;
            case "sad":
                <ellipse class="g-eye" cx="45" cy="66" rx="7" ry="8" /><ellipse class="g-eye" cx="75" cy="66" rx="7" ry="8" />
                <circle class="g-pupil" cx="45" cy="69" r="3.6" /><circle class="g-pupil" cx="75" cy="69" r="3.6" />
                <path class="g-line" d="M37 56l12 3M83 56l-12 3" />
                <path class="g-line" d="M50 88q10-7 20 0" />
                <path class="g-tear" d="M38 76q-3 6 0 8q3-2 0-8z" />
                break;
            case "cry":
                <path class="g-line thick" d="M38 66q7-5 14 0M68 66q7-5 14 0" />
                <path class="g-mouth" d="M48 90q12-14 24 0z" />
                <path class="g-tear stream" d="M40 70q-4 14-2 30q4 2 6 0q-2-16-4-30z" />
                <path class="g-tear stream r" d="M80 70q4 14 2 30q-4 2-6 0q2-16 4-30z" />
                break;
            case "shocked":
                <circle class="g-eye" cx="45" cy="64" r="9" /><circle class="g-eye" cx="75" cy="64" r="9" />
                <circle class="g-pupil" cx="45" cy="64" r="3.4" /><circle class="g-pupil" cx="75" cy="64" r="3.4" />
                <ellipse class="g-mouth" cx="60" cy="88" rx="6" ry="8" />
                <path class="g-line" d="M10 40l8 6M110 40l-8 6M14 28l9 3M106 28l-9 3" />
                break;
            case "wink":
                <ellipse class="g-eye" cx="45" cy="64" rx="7" ry="9" /><circle class="g-pupil" cx="46" cy="66" r="3.8" />
                <path class="g-line" d="M68 66q7-6 14 0" />
                <path class="g-mouth" d="M48 82q12 12 24 0z" />
                <ellipse class="g-cheek" cx="34" cy="78" rx="6" ry="3.5" /><ellipse class="g-cheek" cx="86" cy="78" rx="6" ry="3.5" />
                break;
            case "cheer":
                <path class="g-line thick" d="M37 66q8-10 16 0M67 66q8-10 16 0" />
                <path class="g-mouth" d="M44 78q16 22 32 0z" />
                <ellipse class="g-cheek" cx="32" cy="78" rx="6.5" ry="3.8" /><ellipse class="g-cheek" cx="88" cy="78" rx="6.5" ry="3.8" />
                <path class="g-arm" d="M18 72q-12-6-12-20M102 72q12-6 12-20" />
                <path class="g-spark" d="M2 30l2 6 6 2-6 2-2 6-2-6-6-2 6-2zM114 14l1.5 4.5 4.5 1.5-4.5 1.5-1.5 4.5-1.5-4.5-4.5-1.5 4.5-1.5z" />
                break;
            case "jumpy":
                <circle class="g-eye" cx="45" cy="63" r="8" /><circle class="g-eye" cx="75" cy="63" r="8" />
                <circle class="g-pupil" cx="47" cy="61" r="4" /><circle class="g-pupil" cx="77" cy="61" r="4" />
                <path class="g-mouth" d="M44 78q16 24 32 0z" />
                <path class="g-arm" d="M18 66q-14-10-10-28M102 66q14-10 10-28" />
                <path class="g-spark" d="M0 20l2 6 6 2-6 2-2 6-2-6-6-2 6-2zM118 34l1.5 4.5 4.5 1.5-4.5 1.5-1.5 4.5-1.5-4.5-4.5-1.5 4.5-1.5zM60 -4l1.5 4.5 4.5 1.5-4.5 1.5-1.5 4.5-1.5-4.5-4.5-1.5 4.5-1.5z" />
                break;
            case "angry":
                <path class="g-line thick" d="M34 54l18 8M86 54l-18 8" />
                <ellipse class="g-eye" cx="45" cy="68" rx="6" ry="5" /><ellipse class="g-eye" cx="75" cy="68" rx="6" ry="5" />
                <circle class="g-pupil" cx="46" cy="69" r="3" /><circle class="g-pupil" cx="74" cy="69" r="3" />
                <path class="g-line thick" d="M48 90q12-8 24 0" />
                <ellipse class="g-cheek angry" cx="32" cy="80" rx="7" ry="4" /><ellipse class="g-cheek angry" cx="88" cy="80" rx="7" ry="4" />
                <path class="g-steam" d="M14 32q-6-6 0-12q6-6 0-12M106 32q6-6 0-12q-6-6 0-12" />
                break;
            case "laugh":
                <path class="g-line thick" d="M37 64q8-8 16 2M67 66q8-10 16-2" />
                <path class="g-mouth" d="M42 76q18 28 36 0z" /><path class="g-tongue" d="M52 88q8 6 16 0q-8-4-16 0z" />
                <path class="g-tear" d="M30 64q-6 6-2 10q5-1 2-10zM90 64q6 6 2 10q-5-1-2-10z" />
                break;
            case "love":
                <path class="g-heart-eye" d="M45 72l-9-9a5.5 5.5 0 0 1 9-6a5.5 5.5 0 0 1 9 6z" />
                <path class="g-heart-eye" d="M75 72l-9-9a5.5 5.5 0 0 1 9-6a5.5 5.5 0 0 1 9 6z" />
                <path class="g-mouth" d="M50 82q10 10 20 0z" />
                <ellipse class="g-cheek" cx="32" cy="80" rx="6.5" ry="3.8" /><ellipse class="g-cheek" cx="88" cy="80" rx="6.5" ry="3.8" />
                <path class="g-heart float" d="M104 30l-8-8a5 5 0 0 1 8-5a5 5 0 0 1 8 5z" />
                break;
            case "cool":
                <path class="g-shades" d="M30 58h60v4c0 9-6 14-13 14s-12-5-13-12h-8c-1 7-6 12-13 12s-13-5-13-14z" />
                <path class="g-shades-glint" d="M36 62l6-3M70 62l6-3" />
                <path class="g-line thick" d="M50 88q12 6 22-4" />
                break;
            case "think":
                <ellipse class="g-eye" cx="45" cy="66" rx="6" ry="8" /><ellipse class="g-eye" cx="75" cy="64" rx="7" ry="9" />
                <circle class="g-pupil" cx="48" cy="62" r="3.4" /><circle class="g-pupil" cx="78" cy="60" r="3.6" />
                <path class="g-line" d="M37 54l12-2M68 50l14 4" />
                <path class="g-line" d="M52 88h14" />
                <path class="g-arm" d="M30 100q-4-14 16-14" />
                <circle class="g-dot d1" cx="96" cy="26" r="3" /><circle class="g-dot d2" cx="106" cy="18" r="3.5" /><circle class="g-dot d3" cx="117" cy="9" r="4" />
                break;
            case "wave":
                <ellipse class="g-eye" cx="45" cy="64" rx="7" ry="9" /><ellipse class="g-eye" cx="75" cy="64" rx="7" ry="9" />
                <circle class="g-pupil" cx="46" cy="66" r="3.8" /><circle class="g-pupil" cx="76" cy="66" r="3.8" />
                <path class="g-mouth" d="M48 80q12 14 24 0z" />
                <ellipse class="g-cheek" cx="34" cy="78" rx="6" ry="3.5" /><ellipse class="g-cheek" cx="86" cy="78" rx="6" ry="3.5" />
                <path class="g-arm waving" d="M102 72q14-8 12-30" />
                break;
            case "gg":
                <path class="g-line thick" d="M37 66q8-8 16 0M67 66q8-8 16 0" />
                <path class="g-mouth" d="M50 82q10 10 20 0z" />
                <path class="g-arm" d="M102 76q10-6 10-24" />
                <g class="g-flag"><path class="g-pole" d="M112 54V8" /><path class="g-cloth" d="M112 8h-26l5 9-5 9h26z" /></g>
                break;
            default: // happy
                <ellipse class="g-eye" cx="45" cy="64" rx="7" ry="9" /><ellipse class="g-eye" cx="75" cy="64" rx="7" ry="9" />
                <circle class="g-pupil" cx="46" cy="66" r="3.8" /><circle class="g-pupil" cx="76" cy="66" r="3.8" />
                <circle class="g-glint" cx="44" cy="62" r="1.6" /><circle class="g-glint" cx="74" cy="62" r="1.6" />
                <path class="g-mouth" d="M50 82q10 10 20 0z" />
                <ellipse class="g-cheek" cx="34" cy="78" rx="6" ry="3.5" /><ellipse class="g-cheek" cx="86" cy="78" rx="6" ry="3.5" />
                break;
        }
    </g>
</svg>

@code {
    private const string BodyPath = "M18 64a42 42 0 0 1 84 0v40c-5 7.5-9.5 7.5-14 0s-9.5-7.5-14 0-9.5 7.5-14 0-9.5-7.5-14 0-9.5 7.5-14 0-9.5-7.5-14 0z";

    /// <summary>All moods, in emote-picker order.</summary>
    public static readonly string[] Moods = ["happy", "laugh", "jumpy", "love", "cool", "think", "wave", "gg", "sad", "cry", "angry", "shocked", "sleepy", "wink", "cheer"];

    /// <summary>One of <see cref="Moods"/>.</summary>
    [Parameter] public string Mood { get; set; } = "happy";
    /// <summary>Width in px.</summary>
    [Parameter] public int Size { get; set; } = 64;
    /// <summary>Idle animation for the mood (off under reduced motion).</summary>
    [Parameter] public bool Bob { get; set; } = true;
    /// <summary>Accessible label; null = decorative.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }
}
