@* Ghosty, the mascot: a purple ghost-blob, the "vanishing piece" come to life. A faded dashed O halo floats above
   its head (the ghost of a vanished piece). Mood changes eyes, mouth and pose. Decorative unless Label is set. *@
<svg class="ghosty mood-@Mood @(Bob ? "bob" : null) @Class" viewBox="0 0 120 128" width="@Size" height="@(Size * 128 / 120)"
     role="@(Label is null ? "presentation" : "img")" aria-label="@Label" aria-hidden="@(Label is null ? "true" : null)">
    <circle class="g-halo" cx="60" cy="14" r="10" />
    <g class="g-body-wrap">
        <path class="g-shadow" d="M18 64a42 42 0 0 1 84 0v40c-5 7.5-9.5 7.5-14 0s-9.5-7.5-14 0-9.5 7.5-14 0-9.5-7.5-14 0-9.5 7.5-14 0-9.5-7.5-14 0z" transform="translate(0 6)" />
        <path class="g-body" d="M18 64a42 42 0 0 1 84 0v40c-5 7.5-9.5 7.5-14 0s-9.5-7.5-14 0-9.5 7.5-14 0-9.5-7.5-14 0-9.5 7.5-14 0-9.5-7.5-14 0z" />
        <ellipse class="g-shine" cx="42" cy="44" rx="10" ry="6" transform="rotate(-30 42 44)" />
        @switch (Mood)
        {
            case "sleepy":
                <path class="g-line" d="M38 64q7 5 14 0M68 64q7 5 14 0" />
                <path class="g-line" d="M54 84q6-3 12 0" />
                <path class="g-z" d="M88 26h9l-9 10h9M101 14h6l-6 7h6" />
                break;
            case "sad":
                <ellipse class="g-eye" cx="45" cy="66" rx="7" ry="8" /><ellipse class="g-eye" cx="75" cy="66" rx="7" ry="8" />
                <circle class="g-pupil" cx="45" cy="69" r="3.6" /><circle class="g-pupil" cx="75" cy="69" r="3.6" />
                <path class="g-line" d="M37 56l12 3M83 56l-12 3" />
                <path class="g-line" d="M50 88q10-7 20 0" />
                <path class="g-tear" d="M38 76q-3 6 0 8q3-2 0-8z" />
                break;
            case "shocked":
                <circle class="g-eye" cx="45" cy="64" r="9" /><circle class="g-eye" cx="75" cy="64" r="9" />
                <circle class="g-pupil" cx="45" cy="64" r="3.4" /><circle class="g-pupil" cx="75" cy="64" r="3.4" />
                <ellipse class="g-mouth" cx="60" cy="88" rx="6" ry="8" />
                break;
            case "wink":
                <ellipse class="g-eye" cx="45" cy="64" rx="7" ry="9" /><circle class="g-pupil" cx="46" cy="66" r="3.8" />
                <path class="g-line" d="M68 66q7-6 14 0" />
                <path class="g-mouth" d="M48 82q12 12 24 0z" />
                <ellipse class="g-cheek" cx="34" cy="78" rx="6" ry="3.5" /><ellipse class="g-cheek" cx="86" cy="78" rx="6" ry="3.5" />
                break;
            case "cheer":
                <path class="g-line thick" d="M37 66q8-10 16 0M67 66q8-10 16 0" />
                <path class="g-mouth" d="M44 78q16 22 32 0z" />
                <ellipse class="g-cheek" cx="32" cy="78" rx="6.5" ry="3.8" /><ellipse class="g-cheek" cx="88" cy="78" rx="6.5" ry="3.8" />
                <path class="g-arm" d="M18 72q-12-6-12-20M102 72q12-6 12-20" />
                <path class="g-spark" d="M10 30l2 6 6 2-6 2-2 6-2-6-6-2 6-2zM110 18l1.5 4.5 4.5 1.5-4.5 1.5-1.5 4.5-1.5-4.5-4.5-1.5 4.5-1.5z" />
                break;
            default: // happy
                <ellipse class="g-eye" cx="45" cy="64" rx="7" ry="9" /><ellipse class="g-eye" cx="75" cy="64" rx="7" ry="9" />
                <circle class="g-pupil" cx="46" cy="66" r="3.8" /><circle class="g-pupil" cx="76" cy="66" r="3.8" />
                <circle class="g-glint" cx="44" cy="62" r="1.6" /><circle class="g-glint" cx="74" cy="62" r="1.6" />
                <path class="g-mouth" d="M50 82q10 10 20 0z" />
                <ellipse class="g-cheek" cx="34" cy="78" rx="6" ry="3.5" /><ellipse class="g-cheek" cx="86" cy="78" rx="6" ry="3.5" />
                break;
        }
    </g>
</svg>

@code {
    /// <summary>happy | cheer | sad | sleepy | wink | shocked.</summary>
    [Parameter] public string Mood { get; set; } = "happy";
    /// <summary>Width in px.</summary>
    [Parameter] public int Size { get; set; } = 64;
    /// <summary>Idle float animation (off under reduced motion).</summary>
    [Parameter] public bool Bob { get; set; } = true;
    /// <summary>Accessible label; null = decorative.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }
}
