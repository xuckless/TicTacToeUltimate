@if (Href is not null && !Disabled)
{
    <a class="t-btn t-btn--@Variant @(Block ? "t-btn--block" : null) @(Variant == "hero" ? "perch-x perch-o" : null) @(Small ? "t-btn--sm" : null) @Class" href="@Href" @attributes="Attributes">@ChildContent</a>
}
else
{
    <button type="@Type" class="t-btn t-btn--@Variant @(Block ? "t-btn--block" : null) @(Variant == "hero" ? "perch-x perch-o" : null) @(Small ? "t-btn--sm" : null) @Class" disabled="@Disabled"
            @onclick="OnClick" @attributes="Attributes">@ChildContent</button>
}

@code {
    /// <summary>primary | secondary | ghost | danger | dashed | hero.</summary>
    [Parameter] public string Variant { get; set; } = "primary";
    /// <summary>Full width.</summary>
    [Parameter] public bool Block { get; set; }
    /// <summary>Compact (still at least 44 px).</summary>
    [Parameter] public bool Small { get; set; }
    /// <summary>Disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Renders as a link when set.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>Button type.</summary>
    [Parameter] public string Type { get; set; } = "button";
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>Click handler.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    /// <summary>Content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Extra attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
