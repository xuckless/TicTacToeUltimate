@* Line icons from the design system (24x24, stroke currentColor). *@
<svg class="t-icon @Class" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "home": <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /> break;
        case "play": <path d="M4 4h16v16H4z" /><path d="M9.5 4v16M14.5 4v16M4 9.5h16M4 14.5h16" /> break;
        case "social": <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c2 .7 3.2 2.5 3.6 5.2" /> break;
        case "profile": <circle cx="12" cy="8" r="4" /><path d="M4 21c1-4.2 4-6.5 8-6.5s7 2.3 8 6.5" /> break;
        case "settings": <circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" /> break;
        case "emote": <circle cx="12" cy="12" r="9" /><path d="M8.5 14.5c1 1.3 2.1 2 3.5 2s2.5-.7 3.5-2M9 9.5h.01M15 9.5h.01" /> break;
        case "flag": <path d="M5 21V4M5 4h11l-2 4 2 4H5" /> break;
        case "more": <path d="M5 12h.01M12 12h.01M19 12h.01" /> break;
        case "close": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "back": <path d="M15 5l-7 7 7 7" /> break;
        case "share": <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M12 3v12M7 8l5-5 5 5" /> break;
        case "trophy": <path d="M8 4h8v5a4 4 0 0 1-8 0zM8 6H4a3 3 0 0 0 4 4M16 6h4a3 3 0 0 1-4 4M12 13v4M8 21h8M9 17h6" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "history": <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2" /> break;
        case "send": <path d="M4 12l16-8-6 16-2-7z" /> break;
        case "eye": <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /> break;
        case "prev": <path d="M15 5l-7 7 7 7" /> break;
        case "next": <path d="M9 5l7 7-7 7" /> break;
        default: <circle cx="12" cy="12" r="2" /> break;
    }
</svg>

@code {
    /// <summary>Icon name.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }
}
