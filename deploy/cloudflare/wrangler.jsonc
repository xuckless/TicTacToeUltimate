{
  // Static web build + API proxy (worker.js). Deploy: deploy/web/build.sh, then `wrangler deploy -c deploy/cloudflare/wrangler.jsonc`.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tictactoeultimate-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/hubs/*", "/health", "/.well-known/*"]
  },
  "vars": { "ORIGIN": "https://136-108-68-64.sslip.io" },
  "routes": [{ "pattern": "tictactoeultimate.alidirect.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
